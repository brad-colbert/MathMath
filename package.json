{
  "name": "mathmath",
  "version": "0.37.0",
  "private": true,
  "description": "Web-based engineering math application with a WYSIWYG paper interface",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check:sync": "node scripts/check-sync-flags.mjs",
    "pretest": "npm run --silent check:sync",
    "test": "vitest run",
    "prebuild": "npm run --silent check:sync",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "scoreboard": "tsx src/cli/scoreboard.ts",
    "bench": "tsx bench/error-diffusion.ts",
    "roundtrip": "tsx src/cli/roundtrip.ts",
    "help:results": "tsx src/cli/help-results.ts",
    "examples": "tsx examples/build.mts",
    "dev": "vite",
    "serve": "scripts/serve.sh",
    "test:e2e": "tsx test/e2e/app.e2e.ts",
    "test:deployed": "tsx test/e2e/deployed.e2e.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "mathlive": "0.111.4",
    "puppeteer-core": "^25.16.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12"
  }
}
