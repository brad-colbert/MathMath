,"args":[{"k":"op","op":"plus","args":[{"k":"op","op":"pow","args":[{"k":"op","op":"indexer","args":[{"k":"id","name":"u"},{"k":"id","name":"i"}]},{"k":"real","v":2}]},{"k":"op","op":"pow","args":[{"k":"op","op":"indexer","args":[{"k":"id","name":"v"},{"k":"id","name":"i"}]},{"k":"real","v":2}]}]},{"k":"real","v":1}]},"lo":null,"hi":null}]},{"k":"id","name":"π.est"}]},"stored":null,"unit":null}},{"id":"18","left":54,"top":654.5,"alignX":54,"alignY":670.5,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"k"},"value":{"k":"range","first":{"k":"real","v":0},"second":null,"last":{"k":"real","v":100}},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"19","left":164,"top":654.5,"alignX":164,"alignY":670.5,"disabled":false,"content":{"k":"define","target":{"k":"index","name":"T","index":[{"k":"real","v":0}]},"value":{"k":"real","v":90},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"20","left":254,"top":654.5,"alignX":254,"alignY":670.5,"disabled":false,"content":{"k":"define","target":{"k":"index","name":"T","index":[{"k":"op","op":"plus","args":[{"k":"id","name":"k"},{"k":"real","v":1}]}]},"value":{"k":"call","fn":{"k":"id","name":"until"},"args":[{"k":"op","op":"minus","args":[{"k":"op","op":"indexer","args":[{"k":"id","name":"T"},{"k":"id","name":"k"}]},{"k":"real","v":60}]},{"k":"op","op":"minus","args":[{"k":"op","op":"indexer","args":[{"k":"id","name":"T"},{"k":"id","name":"k"}]},{"k":"op","op":"mult","args":[{"k":"real","v":0.08},{"k":"op","op":"minus","args":[{"k":"op","op":"indexer","args":[{"k":"id","name":"T"},{"k":"id","name":"k"}]},{"k":"real","v":20}]}]}]}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"21","left":54,"top":692.5,"alignX":54,"alignY":708.5,"disabled":false,"content":{"k":"eval","expr":{"k":"call","fn":{"k":"id","name":"rows"},"args":[{"k":"id","name":"T"}]},"stored":null,"unit":null}},{"id":"22","left":214,"top":692.5,"alignX":214,"alignY":708.5,"disabled":false,"content":{"k":"eval","expr":{"k":"op","op":"indexer","args":[{"k":"id","name":"T"},{"k":"op","op":"minus","args":[{"k":"call","fn":{"k":"id","name":"rows"},"args":[{"k":"id","name":"T"}]},{"k":"real","v":1}]}]},"stored":null,"unit":null}},{"id":"25","left":54,"top":965.5,"alignX":54,"alignY":995.5,"disabled":false,"content":{"k":"define","target":{"k":"fn","name":"r","params":["a","n"]},"value":{"k":"program","body":[{"k":"assign","target":{"k":"var","name":"x"},"value":{"k":"id","name":"a"}},{"k":"for","varName":"j","iter":{"k":"range","first":{"k":"real","v":1},"second":null,"last":{"k":"id","name":"n"}},"body":{"k":"block","body":[{"k":"assign","target":{"k":"var","name":"x"},"value":{"k":"op","op":"minus","args":[{"k":"id","name":"x"},{"k":"op","op":"div","args":[{"k":"op","op":"minus","args":[{"k":"op","op":"pow","args":[{"k":"id","name":"x"},{"k":"real","v":2}]},{"k":"real","v":2}]},{"k":"op","op":"mult","args":[{"k":"real","v":2},{"k":"id","name":"x"}]}]}]}},{"k":"assign","target":{"k":"var","name":"t"},"value":{"k":"call","fn":{"k":"id","name":"trace"},"args":[{"k":"str","v":"step {0}: x = {1}"},{"k":"id","name":"j"},{"k":"id","name":"x"}]}}]}},{"k":"expr","e":{"k":"id","name":"x"}}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"26","left":384,"top":979.5,"alignX":384,"alignY":995.5,"disabled":false,"content":{"k":"eval","expr":{"k":"call","fn":{"k":"id","name":"r"},"args":[{"k":"real","v":1},{"k":"real","v":5}]},"stored":null,"unit":null}}],"texts":[{"id":"1","left":54,"top":72,"width":440,"height":27,"text":"Three tools for working with steps and chance: a random experiment you can repeat, a sequence that stops itself, and a program that reports as it runs."},{"id":"2","left":54,"top":107,"width":440,"height":54,"text":"Estimating π by throwing darts. Points scattered evenly over a unit square land inside the quarter circle x² + y² < 1 with probability π/4, so 4 × the fraction inside estimates π. Seed fixes where the draws start, so the same seed gives the same darts, and the same estimate, again."},{"id":"11","left":294,"top":283,"width":254,"height":60,"text":"The darts: those inside the quarter circle count toward π. With 2000 darts the estimate is typically within a few hundredths; the error shrinks like 1/√N."},{"id":"12","left":54,"top":469,"width":440,"height":27,"text":"Seeding again with 42 throws the same darts, so this second estimate is the same to the last digit. Seed gives back the seed that was in effect, here 42."},{"id":"17","left":54,"top":606,"width":440,"height":40.5,"text":"A cup of coffee cooling. Each minute it loses 8% of its difference from the 20 °C room: T_(k+1) = T_k − 0.08·(T_k − 20). until stops the sequence at the first minute the coffee is cool enough to drink, below 60 °C, so the vector's length says how long that takes."},{"id":"23","left":54,"top":864,"width":440,"height":27,"text":"T₀ is the start, so the cup first drops below 60 °C after rows(T) − 1 minutes. Without until, the definition would carry on to k = 100."},{"id":"24","left":54,"top":917,"width":440,"height":40.5,"text":"Following a program. Newton's method for √2: each step replaces x by x − (x² − 2)/(2x). trace prints a line under the region at every step, which shows how fast the digits settle: about twice as many correct each time."},{"id":"27","left":54,"top":1101.5,"width":440,"height":27,"text":"The lines under r(1, 5) are what trace printed; they're for reading as you work, and aren't printed with the sheet. pause prints the same way, and in Mathcad also stops to wait."}],"opaque":[],"origin":0,"tol":0.001,"exactCompare":true,"zeroOverZero":false,"otherRegions":{},"componentOutputs":[]}}