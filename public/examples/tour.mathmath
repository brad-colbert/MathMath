:54,"top":1066.5,"alignX":54,"alignY":1089.5,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"M"},"value":{"k":"matrix","rows":2,"cols":2,"items":[{"k":"real","v":2},{"k":"real","v":1},{"k":"real","v":1},{"k":"real","v":3}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"31","left":222,"top":1066.5,"alignX":222,"alignY":1089.5,"disabled":false,"content":{"k":"eval","expr":{"k":"op","op":"pow","args":[{"k":"id","name":"M"},{"k":"real","v":-1}]},"stored":null,"unit":null}},{"id":"32","left":390,"top":1066.5,"alignX":390,"alignY":1089.5,"disabled":false,"content":{"k":"eval","expr":{"k":"call","fn":{"k":"id","name":"eigenvals"},"args":[{"k":"id","name":"M"}]},"stored":null,"unit":null}},{"id":"34","left":54,"top":1171.5,"alignX":54,"alignY":1191.5,"disabled":false,"content":{"k":"sym","target":null,"global":false,"expr":{"k":"derivative","varName":"x","body":{"k":"op","op":"mult","args":[{"k":"op","op":"pow","args":[{"k":"id","name":"x"},{"k":"real","v":2}]},{"k":"call","fn":{"k":"id","name":"sin"},"args":[{"k":"id","name":"x"}]}]}},"commands":[],"stored":null}},{"id":"35","left":306,"top":1171.5,"alignX":306,"alignY":1191.5,"disabled":false,"content":{"k":"sym","target":null,"global":false,"expr":{"k":"bigop","op":"integral","varName":"x","body":{"k":"op","op":"pow","args":[{"k":"id","name":"x"},{"k":"real","v":2}]},"lo":{"k":"real","v":0},"hi":{"k":"real","v":1}},"commands":[],"stored":null}},{"id":"36","left":54,"top":1217.5,"alignX":54,"alignY":1233.5,"disabled":false,"content":{"k":"sym","target":null,"global":false,"expr":{"k":"op","op":"pow","args":[{"k":"op","op":"plus","args":[{"k":"id","name":"u"},{"k":"real","v":1}]},{"k":"real","v":3}]},"commands":[{"name":"expand","args":[]}],"stored":null}}],"texts":[{"id":"1","left":54,"top":72,"width":440,"height":27,"text":"A two-minute tour of MathMath. Every result on this page is live: change a number and everything below it follows."},{"id":"2","left":54,"top":107,"width":440,"height":13.5,"text":"1. Write math as on paper. Type a colon for :=, the definition sign, and = to see a value."},{"id":"6","left":54,"top":184.5,"width":440,"height":27,"text":"2. Units keep you honest. A car braking from 100 km/h at 7.5 m/s²: MathMath converts as it goes, and shows each result in the unit you choose."},{"id":"13","left":54,"top":311.5,"width":440,"height":13.5,"text":"Adding a distance to a time is a mistake, and MathMath says so rather than giving a number:"},{"id":"15","left":54,"top":389,"width":440,"height":27,"text":"3. Functions and plots. Define a function, give x a range, and plot it: click on empty paper and type @ for a plot."},{"id":"19","left":344,"top":500,"width":204,"height":60,"text":"A damped sine. Hover over the plot to read its points."},{"id":"20","left":54,"top":864,"width":440,"height":27,"text":"4. Solve. root finds where f crosses zero between 2 and 4, at π; a solve block, Given … Find, solves equations together."},{"id":"29","left":54,"top":1045,"width":440,"height":13.5,"text":"5. Matrices. Ctrl+M makes one; the usual operators and functions work on them."},{"id":"33","left":54,"top":1136.5,"width":440,"height":27,"text":"6. Exact answers. Press Ctrl+. for → and MathMath works symbolically: derivatives, integrals and more."},{"id":"37","left":54,"top":1273.5,"width":440,"height":27,"text":"7. Where next. Open more examples from Examples on the toolbar. Press F1 while typing a function's name for its help, or open Help for everything."}],"opaque":[],"origin":0,"tol":0.001,"exactCompare":true,"zeroOverZero":false,"otherRegions":{},"componentOutputs":[]}}