:2},{"k":"id","name":"π"}]},{"k":"real","v":36},{"k":"real","v":18}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"7","left":54,"top":297.5,"alignX":54,"alignY":297.5,"disabled":false,"content":{"k":"plot","x":null,"ys":[{"k":"id","name":"M"}],"markers":false,"width":280,"height":200,"xAxis":{"min":null,"max":null,"log":false},"yAxis":{"min":null,"max":null,"log":false},"view":"surface"}},{"id":"10","left":54,"top":576.5,"alignX":54,"alignY":606.5,"disabled":false,"content":{"k":"define","target":{"k":"fn","name":"H","params":["t"]},"value":{"k":"matrix","rows":3,"cols":1,"items":[{"k":"call","fn":{"k":"id","name":"cos"},"args":[{"k":"id","name":"t"}]},{"k":"call","fn":{"k":"id","name":"sin"},"args":[{"k":"id","name":"t"}]},{"k":"op","op":"div","args":[{"k":"id","name":"t"},{"k":"op","op":"mult","args":[{"k":"real","v":2},{"k":"id","name":"π"}]}]}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"11","left":254,"top":590.5,"alignX":254,"alignY":606.5,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"C"},"value":{"k":"call","fn":{"k":"id","name":"CreateSpace"},"args":[{"k":"id","name":"H"},{"k":"real","v":0},{"k":"op","op":"mult","args":[{"k":"real","v":6},{"k":"id","name":"π"}]},{"k":"real","v":240}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"12","left":54,"top":864,"alignX":54,"alignY":864,"disabled":false,"content":{"k":"plot","x":null,"ys":[{"k":"id","name":"C"}],"markers":false,"width":280,"height":200,"xAxis":{"min":null,"max":null,"log":false},"yAxis":{"min":null,"max":null,"log":false},"view":"surface"}},{"id":"15","left":54,"top":1156.5,"alignX":54,"alignY":1172.5,"disabled":false,"content":{"k":"define","target":{"k":"fn","name":"ρ","params":["θ","ϕ"]},"value":{"k":"op","op":"plus","args":[{"k":"real","v":1},{"k":"op","op":"mult","args":[{"k":"op","op":"mult","args":[{"k":"real","v":0.2},{"k":"call","fn":{"k":"id","name":"cos"},"args":[{"k":"op","op":"mult","args":[{"k":"real","v":4},{"k":"id","name":"θ"}]}]}]},{"k":"call","fn":{"k":"id","name":"sin"},"args":[{"k":"id","name":"ϕ"}]}]}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"16","left":314,"top":1156.5,"alignX":314,"alignY":1172.5,"disabled":false,"content":{"k":"define","target":{"k":"fn","name":"S","params":["θ","ϕ","ρ"]},"value":{"k":"call","fn":{"k":"id","name":"sph2xyz"},"args":[{"k":"id","name":"ρ"},{"k":"id","name":"θ"},{"k":"id","name":"ϕ"}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"17","left":54,"top":1194.5,"alignX":54,"alignY":1210.5,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"B"},"value":{"k":"call","fn":{"k":"id","name":"CreateMesh"},"args":[{"k":"id","name":"ρ"},{"k":"real","v":0},{"k":"op","op":"mult","args":[{"k":"real","v":2},{"k":"id","name":"π"}]},{"k":"real","v":0},{"k":"id","name":"π"},{"k":"real","v":40},{"k":"real","v":20},{"k":"id","name":"S"}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"18","left":54,"top":1232.5,"alignX":54,"alignY":1232.5,"disabled":false,"content":{"k":"plot","x":null,"ys":[{"k":"id","name":"B"}],"markers":false,"width":280,"height":200,"xAxis":{"min":null,"max":null,"log":false},"yAxis":{"min":null,"max":null,"log":false},"view":"surface","view3d":{"azimuth":30,"elevation":25}}},{"id":"21","left":54,"top":1711.5,"alignX":54,"alignY":1734.5,"disabled":false,"content":{"k":"eval","expr":{"k":"call","fn":{"k":"id","name":"xy2pol"},"args":[{"k":"real","v":3},{"k":"real","v":4}]},"stored":null,"unit":null}},{"id":"22","left":204,"top":1704.5,"alignX":204,"alignY":1734.5,"disabled":false,"content":{"k":"eval","expr":{"k":"call","fn":{"k":"id","name":"xyz2sph"},"args":[{"k":"real","v":1},{"k":"real","v":1},{"k":"real","v":1}]},"stored":null,"unit":null}},{"id":"23","left":354,"top":1704.5,"alignX":354,"alignY":1734.5,"disabled":false,"content":{"k":"eval","expr":{"k":"call","fn":{"k":"id","name":"sph2xyz"},"args":[{"k":"call","fn":{"k":"id","name":"xyz2sph"},"args":[{"k":"real","v":1},{"k":"real","v":1},{"k":"real","v":1}]}]},"stored":null,"unit":null}},{"id":"25","left":54,"top":1851.5,"alignX":54,"alignY":1867.5,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"f"},"value":{"k":"call","fn":{"k":"id","name":"logspace"},"args":[{"k":"op","op":"mult","args":[{"k":"real","v":10},{"k":"id","name":"Hz"}]},{"k":"op","op":"mult","args":[{"k":"real","v":100},{"k":"id","name":"kHz"}]},{"k":"real","v":5}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"26","left":314,"top":1823.5,"alignX":314,"alignY":1867.5,"disabled":false,"content":{"k":"eval","expr":{"k":"id","name":"f"},"stored":null,"unit":{"k":"id","name":"Hz"}}},{"id":"27","left":454,"top":1837.5,"alignX":454,"alignY":1867.5,"disabled":false,"content":{"k":"eval","expr":{"k":"call","fn":{"k":"id","name":"logpts"},"args":[{"k":"real","v":0},{"k":"real","v":1},{"k":"real","v":3}]},"stored":null,"unit":null}}],"texts":[{"id":"1","left":54,"top":72,"width":440,"height":40.5,"text":"Shapes in three dimensions. A surface is a function of two parameters that gives a point in space; CreateMesh samples it on a grid, and a 3D plot draws the grid. CreateSpace does the same for a curve, with one parameter."},{"id":"2","left":54,"top":120.5,"width":440,"height":27,"text":"A torus: a circle of radius r swept round a circle of radius R. u goes round the big circle and v round the small one."},{"id":"8","left":364,"top":327.5,"width":184,"height":60,"text":"CreateMesh gives the x, y and z of every grid point, 36 round the big circle and 18 round the small one. Drag the plot to turn it."},{"id":"9","left":54,"top":541.5,"width":440,"height":27,"text":"A helix: one parameter, so CreateSpace, and the plot draws a curve. Three turns, climbing one unit a turn."},{"id":"13","left":364,"top":894,"width":184,"height":60,"text":"A space curve, colored by height. C₀ holds the three vectors of x, y and z: CreateSpace, like CreateMesh, gives them inside a one-element array, as Mathcad does."},{"id":"14","left":54,"top":1108,"width":440,"height":40.5,"text":"A sphere through a mapping. Here the function gives the radius at each pair of angles, and the last argument, fmap, turns each point (θ, φ, radius) into x, y and z with sph2xyz. A radius that varies with the angles makes a lumpier shape."},{"id":"19","left":364,"top":1262.5,"width":184,"height":60,"text":"sph2xyz takes the radius first, so S puts its arguments in the order CreateMesh gives them: the two angles, then the value."},{"id":"20","left":54,"top":1656,"width":440,"height":40.5,"text":"Converting a point. xy2pol and pol2xy in the plane, xyz2sph and sph2xyz, xyz2cyl and cyl2xyz in space; angles in radians. In spherical coordinates θ is round the z axis and φ down from it."},{"id":"24","left":54,"top":1788.5,"width":440,"height":27,"text":"Points on a log scale. logspace spaces points evenly in their logarithm, from one value to another, units and all; logpts spaces them evenly within each decade."},{"id":"28","left":54,"top":1917.5,"width":440,"height":27,"text":"logpts(0, 1, 3) is 1, 4 and 7: a third of the way from 1 to 10 each time, as Mathcad gives it."}],"opaque":[],"origin":0,"tol":0.001,"exactCompare":true,"zeroOverZero":false,"otherRegions":{},"componentOutputs":[]}}