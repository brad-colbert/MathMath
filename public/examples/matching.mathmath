lse}},{"id":"30","left":306,"top":912.5,"alignX":306,"alignY":932.5,"disabled":false,"content":{"k":"define","target":{"k":"index","name":"f","index":[{"k":"id","name":"k"}]},"value":{"k":"op","op":"plus","args":[{"k":"op","op":"mult","args":[{"k":"real","v":80},{"k":"id","name":"MHz"}]},{"k":"op","op":"mult","args":[{"k":"id","name":"k"},{"k":"op","op":"div","args":[{"k":"op","op":"mult","args":[{"k":"real","v":40},{"k":"id","name":"MHz"}]},{"k":"real","v":120}]}]}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"31","left":54,"top":958.5,"alignX":54,"alignY":958.5,"disabled":false,"content":{"k":"plot","x":{"k":"op","op":"indexer","args":[{"k":"id","name":"f"},{"k":"id","name":"k"}]},"ys":[{"k":"call","fn":{"k":"id","name":"Γ.a"},"args":[{"k":"op","op":"indexer","args":[{"k":"id","name":"f"},{"k":"id","name":"k"}]}]},{"k":"call","fn":{"k":"id","name":"Γ.in"},"args":[{"k":"op","op":"indexer","args":[{"k":"id","name":"f"},{"k":"id","name":"k"}]}]}],"markers":false,"width":200,"height":200,"xAxis":{"min":null,"max":null,"log":false},"yAxis":{"min":null,"max":null,"log":false},"view":"smith","traces":[{"color":"#9ca3af","line":"solid","weight":2},{"color":"#2563eb","line":"solid","weight":2}]}},{"id":"32","left":324,"top":958.5,"alignX":324,"alignY":958.5,"disabled":false,"content":{"k":"plot","x":{"k":"op","op":"indexer","args":[{"k":"id","name":"f"},{"k":"id","name":"k"}]},"ys":[{"k":"call","fn":{"k":"id","name":"vswr"},"args":[{"k":"call","fn":{"k":"id","name":"Γ.a"},"args":[{"k":"op","op":"indexer","args":[{"k":"id","name":"f"},{"k":"id","name":"k"}]}]}]},{"k":"call","fn":{"k":"id","name":"vswr"},"args":[{"k":"call","fn":{"k":"id","name":"Γ.in"},"args":[{"k":"op","op":"indexer","args":[{"k":"id","name":"f"},{"k":"id","name":"k"}]}]}]}],"markers":false,"width":200,"height":180,"xAxis":{"min":null,"max":null,"log":false,"unit":{"k":"id","name":"MHz"}},"yAxis":{"min":{"k":"real","v":1},"max":{"k":"real","v":6},"log":false},"traces":[{"color":"#9ca3af","line":"solid","weight":2},{"color":"#2563eb","line":"solid","weight":2}]}}],"texts":[{"id":"1","left":54,"top":72,"width":440,"height":40.5,"text":"Matching an antenna. A small antenna for 100 MHz measures about 25 − 15j Ω, and the radio expects 50 Ω. The mismatch reflects some of the power back to the transmitter. Two parts, an inductor and a capacitor, fix it at the design frequency."},{"id":"2","left":54,"top":120.5,"width":440,"height":13.5,"text":"The antenna. Near resonance it acts as a resistor, an inductor and a capacitor in series."},{"id":"10","left":54,"top":226,"width":440,"height":27,"text":"Its reflection coefficient, the standing-wave ratio on the cable, and how far down the reflection is:"},{"id":"16","left":54,"top":355,"width":440,"height":27,"text":"The match. An L network: an inductor in series with the antenna, then a capacitor across the line. Q comes from the ratio of the resistances."},{"id":"24","left":54,"top":482,"width":440,"height":27,"text":"Looking into the network, the capacitor is in parallel with the inductor and antenna in series:"},{"id":"28","left":54,"top":864,"width":440,"height":40.5,"text":"Across the band. The Smith chart shows the antenna alone, gray, and matched, blue: the match passes through the center, a perfect 50 Ω, at 100 MHz. Right, the standing-wave ratio of each."},{"id":"33","left":54,"top":1184.5,"width":440,"height":27,"text":"Try it: change f₀, and the parts follow. Or round Lm and Cm to values you can buy and see how much of the match survives."}],"opaque":[],"origin":0,"tol":0.001,"exactCompare":true,"zeroOverZero":false,"otherRegions":{},"componentOutputs":[]}}