expr":{"k":"op","op":"indexer","args":[{"k":"id","name":"A"},{"k":"real","v":120}]},"stored":null,"unit":null}},{"id":"21","left":390,"top":1030,"alignX":390,"alignY":1046,"disabled":false,"content":{"k":"eval","expr":{"k":"call","fn":{"k":"id","name":"mean"},"args":[{"k":"id","name":"A"}]},"stored":null,"unit":null}},{"id":"24","left":54,"top":1156,"alignX":54,"alignY":1172,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"G"},"value":{"k":"op","op":"vectorize","args":[{"k":"op","op":"mult","args":[{"k":"id","name":"F"},{"k":"op","op":"greaterThan","args":[{"k":"id","name":"A"},{"k":"real","v":0.15}]}]}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"25","left":222,"top":1156,"alignX":222,"alignY":1172,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"y"},"value":{"k":"call","fn":{"k":"id","name":"ifft"},"args":[{"k":"id","name":"G"}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"26","left":390,"top":1156,"alignX":390,"alignY":1172,"disabled":false,"content":{"k":"eval","expr":{"k":"call","fn":{"k":"id","name":"sum"},"args":[{"k":"op","op":"vectorize","args":[{"k":"op","op":"greaterThan","args":[{"k":"id","name":"A"},{"k":"real","v":0.15}]}]}]},"stored":null,"unit":null}},{"id":"27","left":54,"top":1194,"alignX":54,"alignY":1194,"disabled":false,"content":{"k":"plot","x":{"k":"op","op":"indexer","args":[{"k":"id","name":"t"},{"k":"id","name":"k"}]},"ys":[{"k":"op","op":"indexer","args":[{"k":"id","name":"y"},{"k":"id","name":"k"}]},{"k":"op","op":"indexer","args":[{"k":"id","name":"c"},{"k":"id","name":"k"}]}],"markers":false,"width":440,"height":130,"xAxis":{"min":null,"max":{"k":"op","op":"mult","args":[{"k":"real","v":0.2},{"k":"id","name":"s"}]},"log":false,"unit":{"k":"id","name":"s"}},"yAxis":{"min":null,"max":null,"log":false},"traces":[{"color":"#dc2626","weight":2},{"color":"#2563eb","line":"dash","weight":1.5}]}},{"id":"29","left":54,"top":1371.5,"alignX":54,"alignY":1387.5,"disabled":false,"content":{"k":"eval","expr":{"k":"call","fn":{"k":"id","name":"stdev"},"args":[{"k":"op","op":"minus","args":[{"k":"id","name":"x"},{"k":"id","name":"c"}]}]},"stored":null,"unit":null}},{"id":"30","left":254,"top":1371.5,"alignX":254,"alignY":1387.5,"disabled":false,"content":{"k":"eval","expr":{"k":"call","fn":{"k":"id","name":"stdev"},"args":[{"k":"op","op":"minus","args":[{"k":"id","name":"y"},{"k":"id","name":"c"}]}]},"stored":null,"unit":null}}],"texts":[{"id":"1","left":54,"top":72,"width":440,"height":40.5,"text":"Finding a hum in the noise. A sensor's signal carries mains hum and a vibration, but random noise twice their size hides them. In the time domain it looks like static; the Fourier transform shows what is there."},{"id":"2","left":54,"top":120.5,"width":440,"height":27,"text":"The signal. 1024 samples at 1024 per second: one second. Two tones, 0.5 at 50 Hz and 0.3 at 120 Hz, and normal noise with a standard deviation of 0.8."},{"id":"11","left":54,"top":433.5,"width":440,"height":13.5,"text":"The first 0.2 s: what the sensor gives, gray, and the two tones inside it, blue."},{"id":"12","left":54,"top":473,"width":440,"height":27,"text":"The spectrum. fft gives N/2 + 1 complex values, from 0 Hz up to half the sample rate, one hertz apart here. Scaled by 2/√N, a magnitude is a tone's amplitude."},{"id":"18","left":394,"top":894,"width":154,"height":60,"text":"Two spikes stand clear of the noise floor, at 50 and 120 Hz."},{"id":"22","left":54,"top":1068,"width":440,"height":27,"text":"Close to 0.5 and 0.3. The noise is spread thinly over all 513 frequencies, so each tone towers over it."},{"id":"23","left":54,"top":1121,"width":440,"height":27,"text":"Clean it up. Keep only the frequencies that stand above 0.15, set the rest to zero, and transform back with ifft."},{"id":"28","left":54,"top":1350,"width":440,"height":13.5,"text":"Red, the filtered signal; dashed blue, the true tones. How far each is from the truth:"},{"id":"31","left":54,"top":1409.5,"width":440,"height":27,"text":"The error falls more than tenfold. Try it: raise the noise to 2, or move a tone to 300 Hz. Reroll draws new noise."}],"opaque":[],"origin":0,"tol":0.001,"exactCompare":true,"zeroOverZero":false,"otherRegions":{},"componentOutputs":[]}}