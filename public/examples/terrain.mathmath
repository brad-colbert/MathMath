k":"real","v":0.15},{"k":"id","name":"i"}]}]},{"k":"op","op":"plus","args":[{"k":"real","v":-3},{"k":"op","op":"mult","args":[{"k":"real","v":0.15},{"k":"id","name":"j"}]}]}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"5","left":314,"top":166.5,"alignX":314,"alignY":182.5,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"H"},"value":{"k":"call","fn":{"k":"id","name":"matrix"},"args":[{"k":"real","v":41},{"k":"real","v":41},{"k":"id","name":"f"}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"7","left":54,"top":284.5,"alignX":54,"alignY":335.5,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"T"},"value":{"k":"matrix","rows":6,"cols":3,"items":[{"k":"real","v":20},{"k":"real","v":70},{"k":"real","v":90},{"k":"real","v":160},{"k":"real","v":140},{"k":"real","v":240},{"k":"real","v":50},{"k":"real","v":140},{"k":"real","v":160},{"k":"real","v":190},{"k":"real","v":100},{"k":"real","v":240},{"k":"real","v":120},{"k":"real","v":200},{"k":"real","v":80},{"k":"real","v":90},{"k":"real","v":50},{"k":"real","v":240}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"8","left":274,"top":319.5,"alignX":274,"alignY":335.5,"disabled":false,"content":{"k":"eval","expr":{"k":"call","fn":{"k":"id","name":"SaveColormap"},"args":[{"k":"str","v":"atlas"},{"k":"id","name":"T"}]},"stored":null,"unit":null}},{"id":"9","left":54,"top":422.5,"alignX":54,"alignY":422.5,"disabled":false,"content":{"k":"plot","x":null,"ys":[{"k":"id","name":"H"}],"markers":false,"width":250,"height":200,"xAxis":{"min":null,"max":null,"log":false},"yAxis":{"min":null,"max":null,"log":false},"view":"surface","colorMap":"atlas","title":"atlas"}},{"id":"10","left":306,"top":422.5,"alignX":306,"alignY":422.5,"disabled":false,"content":{"k":"plot","x":null,"ys":[{"k":"id","name":"H"}],"markers":false,"width":230,"height":200,"xAxis":{"min":null,"max":null,"log":false},"yAxis":{"min":null,"max":null,"log":false},"view":"contour","colorMap":"viridis","title":"viridis"}},{"id":"13","left":54,"top":961,"alignX":54,"alignY":977,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"A"},"value":{"k":"call","fn":{"k":"id","name":"LoadColormap"},"args":[{"k":"str","v":"atlas"}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"14","left":274,"top":961,"alignX":274,"alignY":977,"disabled":false,"content":{"k":"eval","expr":{"k":"call","fn":{"k":"id","name":"SaveColormap"},"args":[{"k":"str","v":"land"},{"k":"call","fn":{"k":"id","name":"submatrix"},"args":[{"k":"id","name":"A"},{"k":"real","v":2},{"k":"real","v":5},{"k":"real","v":0},{"k":"real","v":2}]}]},"stored":null,"unit":null}}],"texts":[{"id":"1","left":54,"top":72,"width":440,"height":27,"text":"A surface or contour plot colors its heights by a colour map. MathMath has a few of its own, chosen with Format → Color map…, and a worksheet can make more."},{"id":"2","left":54,"top":107,"width":440,"height":13.5,"text":"A landscape: two hills and a hollow, as a function of x and y, sampled on a 41 × 41 grid."},{"id":"6","left":54,"top":222.5,"width":440,"height":54,"text":"A map of its own, as an atlas colors land: deep water to shallows, then green lowland, brown hills and white peaks. Each row is red, green and blue, 0 to 255, lowest heights first; between rows the colours blend. SaveColormap adds it to the worksheet under a name, gives its number of rows, and offers it as a Mathcad .cmp file to save."},{"id":"11","left":54,"top":864,"width":440,"height":54,"text":"The surface uses the atlas map; the contour plot, viridis, one of MathMath's own, whose steps look evenly spaced and stay distinct for colour-blind readers and in gray print. Select either plot and choose Format → Color map… to try the others: ramp, the default light-to-dark blue, gray, spectrum and heat."},{"id":"12","left":54,"top":926,"width":440,"height":27,"text":"LoadColormap gives a map's colours back as a matrix, to change and save again under another name. Here, the atlas map with the water left out:"},{"id":"15","left":54,"top":999,"width":440,"height":27,"text":"A Mathcad worksheet's own colour map files, as Fire or Royal, can be attached with Files and used by name the same way."}],"opaque":[],"origin":0,"tol":0.001,"exactCompare":true,"zeroOverZero":false,"otherRegions":{},"componentOutputs":[]}}