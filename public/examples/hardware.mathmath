"]},"value":{"k":"op","op":"mult","args":[{"k":"call","fn":{"k":"id","name":"str2num"},"args":[{"k":"call","fn":{"k":"id","name":"substr"},"args":[{"k":"id","name":"c"},{"k":"real","v":1},{"k":"op","op":"minus","args":[{"k":"call","fn":{"k":"id","name":"search"},"args":[{"k":"id","name":"c"},{"k":"str","v":"x"},{"k":"real","v":0}]},{"k":"real","v":1}]}]}]},{"k":"id","name":"mm"}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"25","left":54,"top":1094.5,"alignX":54,"alignY":1110.5,"disabled":false,"content":{"k":"define","target":{"k":"fn","name":"len","params":["c"]},"value":{"k":"op","op":"mult","args":[{"k":"call","fn":{"k":"id","name":"str2num"},"args":[{"k":"call","fn":{"k":"id","name":"substr"},"args":[{"k":"id","name":"c"},{"k":"op","op":"plus","args":[{"k":"call","fn":{"k":"id","name":"search"},"args":[{"k":"id","name":"c"},{"k":"str","v":"x"},{"k":"real","v":0}]},{"k":"real","v":1}]},{"k":"real","v":10}]}]},{"k":"id","name":"mm"}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"26","left":54,"top":1132.5,"alignX":54,"alignY":1148.5,"disabled":false,"content":{"k":"eval","expr":{"k":"call","fn":{"k":"id","name":"d"},"args":[{"k":"str","v":"M10x100"}]},"stored":null,"unit":{"k":"id","name":"mm"}}},{"id":"27","left":224,"top":1132.5,"alignX":224,"alignY":1148.5,"disabled":false,"content":{"k":"eval","expr":{"k":"call","fn":{"k":"id","name":"len"},"args":[{"k":"str","v":"M10x100"}]},"stored":null,"unit":{"k":"id","name":"mm"}}},{"id":"29","left":54,"top":1205.5,"alignX":54,"alignY":1221.5,"disabled":false,"content":{"k":"eval","expr":{"k":"op","op":"minus","args":[{"k":"call","fn":{"k":"id","name":"len"},"args":[{"k":"str","v":"M10x100"}]},{"k":"op","op":"plus","args":[{"k":"op","op":"plus","args":[{"k":"op","op":"mult","args":[{"k":"op","op":"mult","args":[{"k":"real","v":2},{"k":"real","v":38}]},{"k":"id","name":"mm"}]},{"k":"op","op":"mult","args":[{"k":"op","op":"mult","args":[{"k":"real","v":2},{"k":"real","v":2}]},{"k":"id","name":"mm"}]}]},{"k":"op","op":"mult","args":[{"k":"real","v":8},{"k":"id","name":"mm"}]}]}]},"stored":null,"unit":{"k":"id","name":"mm"}}}],"texts":[{"id":"1","left":54,"top":72,"width":440,"height":40.5,"text":"Ordering by the box. The bolts and washers for a garden shed, bought from a catalogue that sells them only in boxes. Strings sit in worksheets beside numbers: type \" in math to start one, and \" again to end it."},{"id":"2","left":54,"top":120.5,"width":440,"height":27,"text":"The catalogue: each row a part code, how many come in a box, and the price of a box in dollars."},{"id":"5","left":54,"top":263.5,"width":440,"height":40.5,"text":"vlookup finds the rows whose first column holds a value and gives back another of their columns, here the price. It gives a vector, since more than one row can match; match says where a value is, as a row and a column."},{"id":"9","left":54,"top":382,"width":440,"height":13.5,"text":"What the drawings call for: a code and a count for each part."},{"id":"13","left":54,"top":483.5,"width":440,"height":27,"text":"Ceil(x, y) rounds x up to a multiple of y, so the bolts and washers we need, rounded up to whole boxes, then the boxes and what they cost:"},{"id":"18","left":54,"top":598.5,"width":440,"height":13.5,"text":"With 8.25% sales tax, rounded to the cent: Round(x, y) rounds to the nearest multiple of y."},{"id":"20","left":54,"top":864,"width":440,"height":13.5,"text":"The order, as text. concat joins strings, and num2str turns a number into one."},{"id":"23","left":54,"top":1021.5,"width":440,"height":27,"text":"Reading the code. A bolt's code is M, its diameter, x, and its length, in millimetres. search finds the x, substr cuts out the digits on each side, and str2num reads them as numbers."},{"id":"28","left":54,"top":1170.5,"width":440,"height":27,"text":"Is the M10 long enough? It goes through two 38 mm timbers with a 2 mm washer under its head and another under an 8 mm nut, and should stick out a few millimetres past the nut:"},{"id":"30","left":54,"top":1243.5,"width":440,"height":27,"text":"12 mm to spare, where the cheaper M10x80 would be 8 mm short. Change the counts in Q, or add a row to the catalogue, and the order rewrites itself."}],"opaque":[],"origin":0,"tol":0.001,"exactCompare":true,"zeroOverZero":false,"otherRegions":{},"componentOutputs":[]}}