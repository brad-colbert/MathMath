.5,"alignX":457.2,"alignY":1136.5,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"ω.0"},"value":{"k":"op","op":"div","args":[{"k":"real","v":1},{"k":"op","op":"sqrt","args":[{"k":"op","op":"mult","args":[{"k":"id","name":"L"},{"k":"id","name":"C.2"}]}]}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"42","left":54,"top":1162.5,"alignX":54,"alignY":1182.5,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"s.1"},"value":{"k":"op","op":"plus","args":[{"k":"op","op":"neg","args":[{"k":"id","name":"α"}]},{"k":"op","op":"sqrt","args":[{"k":"op","op":"minus","args":[{"k":"op","op":"pow","args":[{"k":"id","name":"α"},{"k":"real","v":2}]},{"k":"op","op":"pow","args":[{"k":"id","name":"ω.0"},{"k":"real","v":2}]}]}]}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"43","left":224,"top":1162.5,"alignX":224,"alignY":1182.5,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"s.2"},"value":{"k":"op","op":"minus","args":[{"k":"op","op":"neg","args":[{"k":"id","name":"α"}]},{"k":"op","op":"sqrt","args":[{"k":"op","op":"minus","args":[{"k":"op","op":"pow","args":[{"k":"id","name":"α"},{"k":"real","v":2}]},{"k":"op","op":"pow","args":[{"k":"id","name":"ω.0"},{"k":"real","v":2}]}]}]}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"44","left":394,"top":1166.5,"alignX":394,"alignY":1182.5,"disabled":false,"content":{"k":"eval","expr":{"k":"id","name":"s.1"},"stored":null,"unit":null}},{"id":"45","left":54,"top":1208.5,"alignX":54,"alignY":1228.5,"disabled":false,"content":{"k":"define","target":{"k":"fn","name":"i.2","params":["t"]},"value":{"k":"call","fn":{"k":"id","name":"Re"},"args":[{"k":"op","op":"mult","args":[{"k":"op","op":"div","args":[{"k":"id","name":"V.0"},{"k":"op","op":"mult","args":[{"k":"id","name":"L"},{"k":"op","op":"minus","args":[{"k":"id","name":"s.1"},{"k":"id","name":"s.2"}]}]}]},{"k":"op","op":"minus","args":[{"k":"op","op":"pow","args":[{"k":"id","name":"e"},{"k":"op","op":"mult","args":[{"k":"id","name":"s.1"},{"k":"id","name":"t"}]}]},{"k":"op","op":"pow","args":[{"k":"id","name":"e"},{"k":"op","op":"mult","args":[{"k":"id","name":"s.2"},{"k":"id","name":"t"}]}]}]}]}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"46","left":394,"top":1208.5,"alignX":394,"alignY":1228.5,"disabled":false,"content":{"k":"eval","expr":{"k":"op","op":"div","args":[{"k":"call","fn":{"k":"id","name":"Im"},"args":[{"k":"id","name":"s.1"}]},{"k":"op","op":"mult","args":[{"k":"real","v":2},{"k":"id","name":"π"}]}]},"stored":null,"unit":{"k":"id","name":"Hz"}}},{"id":"47","left":54,"top":1254.5,"alignX":54,"alignY":1254.5,"disabled":false,"content":{"k":"plot","x":{"k":"op","op":"indexer","args":[{"k":"id","name":"t"},{"k":"id","name":"k"}]},"ys":[{"k":"call","fn":{"k":"id","name":"i.2"},"args":[{"k":"op","op":"indexer","args":[{"k":"id","name":"t"},{"k":"id","name":"k"}]}]}],"markers":false,"width":280,"height":160,"xAxis":{"min":null,"max":null,"log":false,"unit":{"k":"id","name":"ms"}},"yAxis":{"min":null,"max":null,"log":false,"unit":{"k":"id","name":"A"}},"traces":[{"color":"#2563eb","weight":2}]}}],"texts":[{"id":"1","left":54,"top":72,"width":440,"height":54,"text":"Phasors and power factor. At one frequency a circuit is just complex arithmetic: a resistor is a real number of ohms, a coil or a capacitor an imaginary one, and a sine wave a complex number whose size is its amplitude and whose angle is its phase. Type a number followed by i for an imaginary one, as 3i; 3j works too, as electrical engineers write it."},{"id":"2","left":54,"top":134,"width":440,"height":13.5,"text":"A motor on a 120 V, 60 Hz supply, modelled as a resistance in series with an inductance."},{"id":"11","left":54,"top":231.5,"width":440,"height":40.5,"text":"The same impedance two ways: as resistance plus reactance, and, under Format → Complex results as magnitude∠angle, as a size and an angle. The current is the voltage over the impedance, and lags it by that angle:"},{"id":"16","left":54,"top":344,"width":440,"height":40.5,"text":"The power. The complex power S is the current squared times the impedance: its real part P does work, its imaginary part Q only sloshes back and forth, and the power factor is the share that does work."},{"id":"22","left":54,"top":486.5,"width":440,"height":27,"text":"Correcting it. A capacitor across the motor draws a current that leads, cancelling the lagging part. The size that cancels all of Q:"},{"id":"30","left":54,"top":613.5,"width":440,"height":40.5,"text":"The motor works as hard as before, but the supply now carries less current, in phase with the voltage. Over one cycle, the instantaneous current is the real part of the phasor turning at ω, √2 times its RMS size:"},{"id":"35","left":364,"top":894,"width":184,"height":60,"text":"Blue: the motor alone. Orange: with the capacitor. Same work, less current in the wires."},{"id":"36","left":54,"top":1068,"width":440,"height":40.5,"text":"Ringing. Switch 10 V onto a series R, L and C. The current is a sum of exponentials whose rates are the roots of L·s² + R·s + 1/C = 0, and when the resistance is small the roots are complex: their real part is the decay and their imaginary part the frequency of the ringing."},{"id":"48","left":364,"top":1284.5,"width":184,"height":60,"text":"One formula covers every case. Try R₂ = 150 Ω: the square root turns real, both roots are real decays, and the current rises and falls without ringing."}],"opaque":[],"origin":0,"tol":0.001,"exactCompare":true,"zeroOverZero":false,"otherRegions":{},"componentOutputs":[]}}