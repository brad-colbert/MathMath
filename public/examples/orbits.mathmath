4,"alignY":1225,"disabled":false,"content":{"k":"define","target":{"k":"fn","name":"d","params":["t"]},"value":{"k":"op","op":"mult","args":[{"k":"id","name":"a.H"},{"k":"op","op":"minus","args":[{"k":"real","v":1},{"k":"op","op":"mult","args":[{"k":"id","name":"ε"},{"k":"call","fn":{"k":"id","name":"cos"},"args":[{"k":"call","fn":{"k":"id","name":"ψ"},"args":[{"k":"id","name":"t"}]}]}]}]}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"32","left":304,"top":1209,"alignX":304,"alignY":1225,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"t"},"value":{"k":"range","first":{"k":"op","op":"mult","args":[{"k":"real","v":0},{"k":"id","name":"yr"}]},"second":{"k":"op","op":"mult","args":[{"k":"real","v":0.1},{"k":"id","name":"yr"}]},"last":{"k":"id","name":"P"}},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"33","left":54,"top":1247,"alignX":54,"alignY":1247,"disabled":false,"content":{"k":"plot","x":{"k":"id","name":"t"},"ys":[{"k":"op","op":"div","args":[{"k":"call","fn":{"k":"id","name":"d"},"args":[{"k":"id","name":"t"}]},{"k":"id","name":"AU"}]}],"markers":false,"width":260,"height":120,"xAxis":{"min":null,"max":null,"log":false,"unit":{"k":"id","name":"yr"}},"yAxis":{"min":null,"max":null,"log":false},"traces":[{"color":"#2563eb","weight":2}]}},{"id":"36","left":54,"top":1428,"alignX":54,"alignY":1448,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"t.J"},"value":{"k":"call","fn":{"k":"id","name":"root"},"args":[{"k":"op","op":"minus","args":[{"k":"call","fn":{"k":"id","name":"d"},"args":[{"k":"id","name":"τ"}]},{"k":"op","op":"mult","args":[{"k":"real","v":5.2},{"k":"id","name":"AU"}]}]},{"k":"id","name":"τ"},{"k":"op","op":"mult","args":[{"k":"real","v":0},{"k":"id","name":"yr"}]},{"k":"op","op":"div","args":[{"k":"id","name":"P"},{"k":"real","v":2}]}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"37","left":384,"top":1432,"alignX":384,"alignY":1448,"disabled":false,"content":{"k":"eval","expr":{"k":"op","op":"mult","args":[{"k":"real","v":2},{"k":"id","name":"t.J"}]},"stored":null,"unit":{"k":"id","name":"yr"}}},{"id":"38","left":484,"top":1428,"alignX":484,"alignY":1448,"disabled":false,"content":{"k":"eval","expr":{"k":"op","op":"div","args":[{"k":"op","op":"mult","args":[{"k":"real","v":2},{"k":"id","name":"t.J"}]},{"k":"id","name":"P"}]},"stored":null,"unit":null}}],"texts":[{"id":"1","left":54,"top":72,"width":440,"height":40.5,"text":"Orbits, from a satellite to a comet. Kepler's third law ties an orbit's size to its period. We use it to find where a satellite must be to hang over one spot on the Earth, then follow Halley's Comet around the Sun."},{"id":"2","left":54,"top":120.5,"width":440,"height":27,"text":"A geostationary orbit goes round once a sidereal day, as the Earth turns. μ is the Earth's gravitational parameter, G times its mass."},{"id":"5","left":54,"top":201.5,"width":440,"height":13.5,"text":"A solve block: a guess for the radius a, then Given, the condition, and Find."},{"id":"12","left":54,"top":307,"width":440,"height":13.5,"text":"About 35 800 km above the equator, where the weather and TV satellites are."},{"id":"13","left":54,"top":346.5,"width":440,"height":27,"text":"Halley's Comet. Its orbit's half-length a and eccentricity ε, and μ for the Sun. AU, the Earth's distance from the Sun, is defined here."},{"id":"22","left":54,"top":557.5,"width":440,"height":13.5,"text":"Closest to the Sun, it is inside Venus's orbit; farthest, beyond Neptune's."},{"id":"23","left":54,"top":597,"width":440,"height":27,"text":"The shape. An ellipse with the Sun at a focus: r as a function of the angle θ from perihelion, drawn on a polar plot with the orbits of the Earth and Jupiter."},{"id":"27","left":314,"top":894,"width":234,"height":60,"text":"Blue, the comet, in AU from the Sun; green, the Earth's orbit, a speck at the center; orange, Jupiter's, at 5.2 AU. The comet swings close round the Sun on the right and spends most of its time far out to the left."},{"id":"28","left":54,"top":1128,"width":440,"height":27,"text":"Where is it now? The mean anomaly M grows evenly with time; Kepler's equation, M = ψ − ε·sin ψ, has no formula for ψ, so root solves it."},{"id":"34","left":354,"top":1277,"width":194,"height":60,"text":"Its distance from the Sun, in AU, over one orbit from perihelion. It races through the inner Solar System and crawls round the far end."},{"id":"35","left":54,"top":1393,"width":440,"height":27,"text":"How long is it inside Jupiter's orbit, 5.2 AU from the Sun? From perihelion until d reaches 5.2 AU, and the same again before:"},{"id":"39","left":54,"top":1474,"width":440,"height":27,"text":"About two years in every 75: under 3% of its time. Try it: Halley's next perihelion is in 2061; change ε to 0.0167 and a to 1 AU for the Earth, and its distance hardly changes at all."}],"opaque":[],"origin":0,"tol":0.001,"exactCompare":true,"zeroOverZero":false,"otherRegions":{},"componentOutputs":[]}}