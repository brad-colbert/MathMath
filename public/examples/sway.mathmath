{"format":"mathmath","version":1,"worksheet":{"page":{"width":612,"height":792,"landscape":false,"margins":{"left":36,"right":36,"top":36,"bottom":36}},"format":{"precision":4,"exponent":5,"trailingZeros":false},"assets":{},"regions":[{"id":"3","left":54,"top":155.5,"alignX":54,"alignY":171.5,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"m.1"},"value":{"k":"op","op":"mult","args":[{"k":"real","v":12000},{"k":"id","name":"kg"}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"4","left":222,"top":155.5,"alignX":222,"alignY":171.5,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"m.2"},"value":{"k":"op","op":"mult","args":[{"k":"real","v":12000},{"k":"id","name":"kg"}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"5","left":390,"top":155.5,"alignX":390,"alignY":171.5,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"m.3"},"value":{"k":"op","op":"mult","args":[{"k":"real","v":8000},{"k":"id","name":"kg"}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"6","left":54,"top":193.5,"alignX":54,"alignY":213.5,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"k.1"},"value":{"k":"op","op":"mult","args":[{"k":"real","v":30000},{"k":"op","op":"div","args":[{"k":"id","name":"kN"},{"k":"id","name":"m"}]}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"7","left":222,"top":193.5,"alignX":222,"alignY":213.5,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"k.2"},"value":{"k":"op","op":"mult","args":[{"k":"real","v":25000},{"k":"op","op":"div","args":[{"k":"id","name":"kN"},{"k":"id","name":"m"}]}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"8","left":390,"top":193.5,"alignX":390,"alignY":213.5,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"k.3"},"value":{"k":"op","op":"mult","args":[{"k":"real","v":20000},{"k":"op","op":"div","args":[{"k":"id","name":"kN"},{"k":"id","name":"m"}]}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"10","left":54,"top":274.5,"alignX":54,"alignY":304.5,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"K"},"value":{"k":"matrix","rows":3,"cols":3,"items":[{"k":"op","op":"plus","args":[{"k":"id","name":"k.1"},{"k":"id","name":"k.2"}]},{"k":"op","op":"neg","args":[{"k":"id","name":"k.2"}]},{"k":"real","v":0},{"k":"op","op":"neg","args":[{"k":"id","name":"k.2"}]},{"k":"op","op":"plus","args":[{"k":"id","name":"k.2"},{"k":"id","name":"k.3"}]},{"k":"op","op":"neg","args":[{"k":"id","name":"k.3"}]},{"k":"real","v":0},{"k":"op","op":"neg","args":[{"k":"id","name":"k.3"}]},{"k":"id","name":"k.3"}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"11","left":384,"top":274.5,"alignX":384,"alignY":304.5,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"M"},"value":{"k":"matrix","rows":3,"cols":3,"items":[{"k":"id","name":"m.1"},{"k":"real","v":0},{"k":"real","v":0},{"k":"real","v":0},{"k":"id","name":"m.2"},{"k":"real","v":0},{"k":"real","v":0},{"k":"real","v":0},{"k":"id","name":"m.3"}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"13","left":54,"top":407.5,"alignX":54,"alignY":423.5,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"ω2"},"value":{"k":"call","fn":{"k":"id","name":"genvals"},"args":[{"k":"id","name":"K"},{"k":"id","name":"M"}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"14","left":254,"top":393.5,"alignX":254,"alignY":423.5,"disabled":false,"content":{"k":"eval","expr":{"k":"id","name":"ω2"},"stored":null,"unit":null}},{"id":"15","left":384,"top":403.5,"alignX":384,"alignY":423.5,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"f"},"value":{"k":"op","op":"div","args":[{"k":"op","op":"vectorize","args":[{"k":"op","op":"sqrt","args":[{"k":"id","name":"ω2"}]}]},{"k":"op","op":"mult","args":[{"k":"real","v":2},{"k":"id","name":"π"}]}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"16","left":514,"top":393.5,"alignX":514,"alignY":423.5,"disabled":false,"content":{"k":"eval","expr":{"k":"id","name":"f"},"stored":null,"unit":{"k":"id","name":"Hz"}}},{"id":"19","left":54,"top":575,"alignX":54,"alignY":591,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"X"},"value":{"k":"call","fn":{"k":"id","name":"genvecs"},"args":[{"k":"id","name":"K"},{"k":"id","name":"M"}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"20","left":254,"top":561,"alignX":254,"alignY":591,"disabled":false,"content":{"k":"eval","expr":{"k":"id","name":"X"},"stored":null,"unit":null}},{"id":"22","left":54,"top":939.5,"alignX":54,"alignY":955.5,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"x"},"value":{"k":"op","op":"matcol","args":[{"k":"id","name":"X"},{"k":"real","v":2}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"23","left":204,"top":939.5,"alignX":204,"alignY":955.5,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"F"},"value":{"k":"op","op":"mult","args":[{"k":"id","name":"K"},{"k":"id","name":"x"}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"24","left":354,"top":939.5,"alignX":354,"alignY":955.5,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"A"},"value":{"k":"op","op":"mult","args":[{"k":"id","name":"M"},{"k":"id","name":"x"}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"25","left":54,"top":977.5,"alignX":54,"alignY":1007.5,"disabled":false,"content":{"k":"eval","expr":{"k":"op","op":"vectorize","args":[{"k":"op","op":"div","args":[{"k":"id","name":"F"},{"k":"id","name":"A"}]}]},"stored":null,"unit":null}},{"id":"26","left":354,"top":991.5,"alignX":354,"alignY":1007.5,"disabled":false,"content":{"k":"eval","expr":{"k":"op","op":"indexer","args":[{"k":"id","name":"ω2"},{"k":"real","v":2}]},"stored":null,"unit":null}},{"id":"28","left":54,"top":1124,"alignX":54,"alignY":1140,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"S"},"value":{"k":"call","fn":{"k":"id","name":"svd2"},"args":[{"k":"id","name":"K"}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"29","left":254,"top":1110,"alignX":254,"alignY":1140,"disabled":false,"content":{"k":"eval","expr":{"k":"op","op":"indexer","args":[{"k":"id","name":"S"},{"k":"real","v":0}]},"stored":null,"unit":{"k":"op","op":"div","args":[{"k":"id","name":"kN"},{"k":"id","name":"m"}]}}},{"id":"30","left":454,"top":1120,"alignX":454,"alignY":1140,"disabled":false,"content":{"k":"eval","expr":{"k":"op","op":"div","args":[{"k":"call","fn":{"k":"id","name":"max"},"args":[{"k":"op","op":"indexer","args":[{"k":"id","name":"S"},{"k":"real","v":0}]}]},{"k":"call","fn":{"k":"id","name":"min"},"args":[{"k":"op","op":"indexer","args":[{"k":"id","name":"S"},{"k":"real","v":0}]}]}]},"stored":null,"unit":null}}],"texts":[{"id":"1","left":54,"top":72,"width":440,"height":40.5,"text":"How a building sways. A three-storey frame is three floors, each a mass, joined by columns that act as springs. Its free vibration is K·x = ω²·M·x, a generalized eigenvalue problem: genvals gives the ω², and genvecs the shapes the frame sways in."},{"id":"2","left":54,"top":120.5,"width":440,"height":27,"text":"The floors' masses and the storeys' stiffnesses, from the ground up. The top floor is a lighter roof."},{"id":"9","left":54,"top":239.5,"width":440,"height":27,"text":"Each floor is pulled by the storey below and the one above, which gives the stiffness matrix; the mass matrix is the masses on its diagonal."},{"id":"12","left":54,"top":358.5,"width":440,"height":27,"text":"The natural frequencies. genvals gives ω² in 1/s², since K/M is (N/m)/kg; the frequency is ω/2π."},{"id":"17","left":54,"top":459.5,"width":440,"height":40.5,"text":"Three modes, at about 13, 9.5 and 3.7 Hz. genvals lists them in the order LAPACK's QZ method finds them, as Mathcad does, here the fastest first; sort them if you want them in order. The slowest, under 4 Hz, is the one wind or traffic would excite."},{"id":"18","left":54,"top":526,"width":440,"height":27,"text":"The mode shapes. Each column of genvecs is how far each floor moves in that mode, scaled so the largest is ±1, as Mathcad scales them."},{"id":"21","left":54,"top":864,"width":440,"height":67.5,"text":"In the slowest mode, the last column, all three floors move the same way, the roof most. In the next the floors move against each other once, and in the fastest twice. The signs are arbitrary, as for any eigenvector, and match Mathcad's. Each column satisfies K·x = ω²·M·x, which checks the answer: for the slowest mode, the springs' force K·x over the floors' mass times their movement, M·x, is ω² on every floor."},{"id":"27","left":54,"top":1061.5,"width":440,"height":40.5,"text":"How stiff the frame is in every direction. svd2 splits K into rotations and its singular values: the largest over the smallest is how much stiffer the frame is against its stiffest pattern of floor movements than against its softest."},{"id":"31","left":54,"top":1176,"width":440,"height":40.5,"text":"The same ratio as cond2(K). Since K is symmetric and positive, its singular values are its ordinary eigenvalues; for the frame as it moves, it is M that weights them, and that is what genvals does."}],"opaque":[],"origin":0,"tol":0.001,"exactCompare":true,"zeroOverZero":false,"otherRegions":{},"componentOutputs":[]}}