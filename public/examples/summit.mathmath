e,"content":{"k":"define","target":{"k":"var","name":"x"},"value":{"k":"real","v":2.8},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"24","left":134,"top":906,"alignX":134,"alignY":922,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"y"},"value":{"k":"real","v":-2.5},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"25","left":214,"top":906,"alignX":214,"alignY":922,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"M"},"value":{"k":"call","fn":{"k":"id","name":"Maximize"},"args":[{"k":"id","name":"h"},{"k":"id","name":"x"},{"k":"id","name":"y"}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"26","left":384,"top":899,"alignX":384,"alignY":922,"disabled":false,"content":{"k":"eval","expr":{"k":"id","name":"M"},"stored":null,"unit":null}},{"id":"27","left":54,"top":951,"alignX":54,"alignY":981,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"T"},"value":{"k":"matrix","rows":3,"cols":1,"items":[{"k":"op","op":"indexer","args":[{"k":"id","name":"M"},{"k":"real","v":0}]},{"k":"op","op":"indexer","args":[{"k":"id","name":"M"},{"k":"real","v":1}]},{"k":"call","fn":{"k":"id","name":"h"},"args":[{"k":"op","op":"indexer","args":[{"k":"id","name":"M"},{"k":"real","v":0}]},{"k":"op","op":"indexer","args":[{"k":"id","name":"M"},{"k":"real","v":1}]}]}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"28","left":254,"top":965,"alignX":254,"alignY":981,"disabled":false,"content":{"k":"eval","expr":{"k":"op","op":"indexer","args":[{"k":"id","name":"S"},{"k":"real","v":320},{"k":"real","v":1}]},"stored":null,"unit":null}},{"id":"29","left":384,"top":965,"alignX":384,"alignY":981,"disabled":false,"content":{"k":"eval","expr":{"k":"op","op":"indexer","args":[{"k":"id","name":"S"},{"k":"real","v":320},{"k":"real","v":2}]},"stored":null,"unit":null}},{"id":"31","left":54,"top":1083.5,"alignX":54,"alignY":1083.5,"disabled":false,"content":{"k":"plot","x":null,"ys":[{"k":"id","name":"h"},{"k":"id","name":"A"},{"k":"id","name":"P"},{"k":"id","name":"T"}],"markers":false,"width":380,"height":300,"xAxis":{"min":{"k":"real","v":-3},"max":{"k":"real","v":3},"log":false},"yAxis":{"min":{"k":"real","v":-3},"max":{"k":"real","v":3},"log":false},"view":"surface","view3d":{"azimuth":-60,"elevation":32},"traces":[null,{"color":"#1f1f1f","weight":1.2},{"color":"#eb6834","weight":2.5},{"color":"#e34948"}],"floorContours":true}},{"id":"33","left":54,"top":1656,"alignX":54,"alignY":1656,"disabled":false,"content":{"k":"plot","x":null,"ys":[{"k":"id","name":"h"},{"k":"id","name":"A"},{"k":"id","name":"P"},{"k":"id","name":"T"}],"markers":false,"width":300,"height":260,"xAxis":{"min":{"k":"real","v":-3},"max":{"k":"real","v":3},"log":false},"yAxis":{"min":{"k":"real","v":-3},"max":{"k":"real","v":3},"log":false},"view":"contour","traces":[null,{"color":"#1f1f1f","weight":1.2},{"color":"#eb6834","weight":2.5,"line":"solid"},{"color":"#e34948"}]}}],"texts":[{"id":"1","left":54,"top":72,"width":440,"height":22,"text":"The way up a hill","style":{"bold":true,"size":16}},{"id":"2","left":54,"top":102,"width":440,"height":40.5,"text":"A walker in fog can only feel the slope underfoot, so goes uphill the steepest way at every step. Where does that lead, and how does it look on the hill? A surface plot draws several things at once, in one box: the hill, arrows, a path and a point."},{"id":"3","left":54,"top":150.5,"width":440,"height":27,"text":"The hill: two rounded peaks, a high one and a lower shoulder. Its gradient ∇h points the way it rises fastest, as steeply as it rises."},{"id":"6","left":54,"top":249.5,"width":440,"height":40.5,"text":"Arrows on the slope. At each point of a grid, the arrow goes ∂h/∂x across and ∂h/∂y along, and rises with the hill: U·∂h/∂x + V·∂h/∂y, which is U² + V², so it lies on the surface. Six arrays X, Y, Z, U, V, W in a vector are arrows in space."},{"id":"16","left":54,"top":500,"width":440,"height":40.5,"text":"The walk. Steepest ascent follows the gradient: the position (x, y) changes in its direction. Dividing by its length, plus a little, keeps the pace steady and lets the walk settle at the top, where the gradient is 0. rkfixed takes it in steps from a start low in the near corner."},{"id":"22","left":54,"top":864,"width":440,"height":27,"text":"The summit, where the walk ends: Maximize climbs from the same start, and the top is marked by its three numbers (x, y, z)."},{"id":"30","left":54,"top":1035,"width":440,"height":40.5,"text":"All four in one plot, over x and y from −3 to 3: the hill colored by height, the arrows dark, the walk in orange, the summit in red. Format → Contour lines below a surface draws the hill's contours on the floor. Drag the plot to turn it: the hill hides what is behind it."},{"id":"32","left":54,"top":1409.5,"width":440,"height":27,"text":"A contour plot takes the same four and shows them from above: the hill's level lines colored by height, the arrows flat, the walk and the summit where they lie."},{"id":"34","left":374,"top":1686,"width":174,"height":60,"text":"Seen this way, the walk crosses each contour at right angles, as the gradient does: steepest ascent is the way that crosses the level lines most directly."},{"id":"35","left":54,"top":1942,"width":440,"height":13.5,"text":"Move the start, or the second peak, and the walk finds its way again."}],"opaque":[],"origin":0,"tol":0.001,"exactCompare":true,"zeroOverZero":false,"otherRegions":{},"componentOutputs":[]}}