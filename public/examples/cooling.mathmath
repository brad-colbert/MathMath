":"id","name":"t"},{"k":"id","name":"T"},{"k":"real","v":2}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"26","left":222,"top":1212.5,"alignX":222,"alignY":1228.5,"disabled":false,"content":{"k":"define","target":{"k":"fn","name":"h","params":["x"]},"value":{"k":"call","fn":{"k":"id","name":"interp"},"args":[{"k":"id","name":"Q"},{"k":"id","name":"t"},{"k":"id","name":"T"},{"k":"id","name":"x"}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"27","left":390,"top":1212.5,"alignX":390,"alignY":1228.5,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"m"},"value":{"k":"range","first":{"k":"real","v":0},"second":null,"last":{"k":"real","v":90}},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"28","left":54,"top":1250.5,"alignX":54,"alignY":1250.5,"disabled":false,"content":{"k":"plot","x":{"k":"id","name":"t"},"ys":[{"k":"op","op":"plus","args":[{"k":"op","op":"indexer","args":[{"k":"id","name":"L"},{"k":"real","v":0}]},{"k":"op","op":"mult","args":[{"k":"op","op":"indexer","args":[{"k":"id","name":"L"},{"k":"real","v":1}]},{"k":"id","name":"t"}]}]},{"k":"op","op":"vectorize","args":[{"k":"call","fn":{"k":"id","name":"f"},"args":[{"k":"id","name":"t"}]}]},{"k":"id","name":"T"}],"markers":false,"width":230,"height":160,"xAxis":{"min":null,"max":null,"log":false},"yAxis":{"min":null,"max":null,"log":false},"traces":[{"color":"#6b7280","line":"dash","weight":2,"points":"none"},{"color":"#2563eb","line":"solid","weight":2,"points":"none"},{"color":"#dc2626","line":"none","points":"circle"}]}},{"id":"29","left":306,"top":1250.5,"alignX":306,"alignY":1250.5,"disabled":false,"content":{"k":"plot","x":{"k":"id","name":"m"},"ys":[{"k":"call","fn":{"k":"id","name":"g"},"args":[{"k":"id","name":"m"}]},{"k":"call","fn":{"k":"id","name":"h"},"args":[{"k":"id","name":"m"}]}],"markers":false,"width":230,"height":160,"xAxis":{"min":null,"max":null,"log":false},"yAxis":{"min":{"k":"real","v":0},"max":{"k":"real","v":100},"log":false},"traces":[{"color":"#2563eb","line":"solid","weight":2,"points":"none"},{"color":"#d97706","line":"dash","weight":2,"points":"none"}]}},{"id":"31","left":54,"top":1695,"alignX":54,"alignY":1711,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"x.60"},"value":{"k":"call","fn":{"k":"id","name":"root"},"args":[{"k":"op","op":"minus","args":[{"k":"call","fn":{"k":"id","name":"g"},"args":[{"k":"id","name":"x"}]},{"k":"real","v":60}]},{"k":"id","name":"x"},{"k":"real","v":0},{"k":"real","v":60}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"32","left":274,"top":1695,"alignX":274,"alignY":1711,"disabled":false,"content":{"k":"eval","expr":{"k":"id","name":"x.60"},"stored":null,"unit":null}},{"id":"33","left":394,"top":1691,"alignX":394,"alignY":1711,"disabled":false,"content":{"k":"eval","expr":{"k":"op","op":"mult","args":[{"k":"op","op":"neg","args":[{"k":"op","op":"indexer","args":[{"k":"id","name":"p"},{"k":"real","v":2}]}]},{"k":"call","fn":{"k":"id","name":"ln"},"args":[{"k":"op","op":"div","args":[{"k":"real","v":1},{"k":"op","op":"minus","args":[{"k":"op","op":"indexer","args":[{"k":"id","name":"p"},{"k":"real","v":1}]},{"k":"op","op":"indexer","args":[{"k":"id","name":"p"},{"k":"real","v":0}]}]}]}]}]},"stored":null,"unit":null}}],"texts":[{"id":"1","left":54,"top":72,"width":440,"height":27,"text":"Fitting a cooling curve. A thermometer in a cup of coffee, read every two minutes for half an hour. Which curve describes it, and what does each say about the hour and a half after?"},{"id":"2","left":54,"top":107,"width":440,"height":27,"text":"The readings: time in minutes and temperature in °C, as plain numbers, since the fitting functions take numbers without units."},{"id":"5","left":54,"top":408,"width":440,"height":27,"text":"A straight line first: line gives its intercept and slope, and stderr how far, typically, the readings lie from it."},{"id":"9","left":54,"top":495,"width":440,"height":27,"text":"Nearly 4 °C off on average, and the misses are not random: the line runs above the readings in the middle and below them at the ends. The data bends."},{"id":"10","left":54,"top":548,"width":440,"height":27,"text":"An exponential. expfit fits a·e^(b·x) + c, and finds a starting guess itself. c is the temperature it settles to, the room, and −1/b its time constant."},{"id":"17","left":54,"top":864,"width":440,"height":13.5,"text":"Less than a tenth of the line's error: what is left is the thermometer's own scatter."},{"id":"18","left":54,"top":903.5,"width":440,"height":40.5,"text":"A model of our own. Newton's law of cooling in the terms we care about: the room temperature, the starting temperature and the time constant. genfit takes the model with its parameters one by one, and a guess for each."},{"id":"23","left":54,"top":1084,"width":440,"height":40.5,"text":"The same curve as expfit's, since it is the same family, but its parameters read off directly. The readings came from a 22 °C room, a 90 °C start and an 18-minute time constant, plus noise."},{"id":"24","left":54,"top":1150.5,"width":440,"height":54,"text":"Inside and outside the data. Left, the readings in red with the line, gray, and the exponential, blue. Right, the next hour and a half: the exponential, blue, and a quadratic from regress, orange, for comparison: inside the readings it fits them well, but just past them it turns and heats the coffee up again."},{"id":"30","left":54,"top":1656,"width":440,"height":27,"text":"When can I drink it? Below about 60 °C. root finds where the fitted model crosses it, and where the coffee gets to within a degree of the room."},{"id":"34","left":54,"top":1737,"width":440,"height":27,"text":"About ten and a half minutes to drink it, and over an hour to reach the room. Try a 30-minute guess for τ, or a degree-3 regress, and see what changes."}],"opaque":[],"origin":0,"tol":0.001,"exactCompare":true,"zeroOverZero":false,"otherRegions":{},"componentOutputs":[]}}