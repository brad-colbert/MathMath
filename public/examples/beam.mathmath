lse,"content":{"k":"plot","x":{"k":"id","name":"x"},"ys":[{"k":"op","op":"neg","args":[{"k":"call","fn":{"k":"id","name":"y"},"args":[{"k":"id","name":"x"},{"k":"op","op":"mult","args":[{"k":"real","v":19},{"k":"id","name":"mm"}]}]}]},{"k":"op","op":"neg","args":[{"k":"call","fn":{"k":"id","name":"y"},"args":[{"k":"id","name":"x"},{"k":"op","op":"mult","args":[{"k":"real","v":25},{"k":"id","name":"mm"}]}]}]}],"markers":false,"width":300,"height":150,"xAxis":{"min":null,"max":null,"log":false,"unit":{"k":"id","name":"mm"}},"yAxis":{"min":null,"max":null,"log":false,"unit":{"k":"id","name":"mm"}},"traces":[{"color":"#2563eb","weight":2},{"color":"#16a34a","line":"solid","weight":2}]}},{"id":"18","left":54,"top":627,"alignX":54,"alignY":647,"disabled":false,"content":{"k":"eval","expr":{"k":"call","fn":{"k":"id","name":"y"},"args":[{"k":"op","op":"div","args":[{"k":"id","name":"L"},{"k":"real","v":2}]},{"k":"op","op":"mult","args":[{"k":"real","v":19},{"k":"id","name":"mm"}]}]},"stored":null,"unit":{"k":"id","name":"mm"}}},{"id":"19","left":304,"top":627,"alignX":304,"alignY":647,"disabled":false,"content":{"k":"eval","expr":{"k":"op","op":"div","args":[{"k":"id","name":"L"},{"k":"real","v":360}]},"stored":null,"unit":{"k":"id","name":"mm"}}},{"id":"21","left":54,"top":885.5,"alignX":54,"alignY":905.5,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"h.min"},"value":{"k":"call","fn":{"k":"id","name":"root"},"args":[{"k":"op","op":"minus","args":[{"k":"call","fn":{"k":"id","name":"y"},"args":[{"k":"op","op":"div","args":[{"k":"id","name":"L"},{"k":"real","v":2}]},{"k":"id","name":"h"}]},{"k":"op","op":"div","args":[{"k":"id","name":"L"},{"k":"real","v":360}]}]},{"k":"id","name":"h"},{"k":"op","op":"mult","args":[{"k":"real","v":5},{"k":"id","name":"mm"}]},{"k":"op","op":"mult","args":[{"k":"real","v":60},{"k":"id","name":"mm"}]}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"22","left":434,"top":889.5,"alignX":434,"alignY":905.5,"disabled":false,"content":{"k":"eval","expr":{"k":"id","name":"h.min"},"stored":null,"unit":{"k":"id","name":"mm"}}},{"id":"24","left":54,"top":984.5,"alignX":54,"alignY":1004.5,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"M"},"value":{"k":"op","op":"div","args":[{"k":"op","op":"mult","args":[{"k":"id","name":"w"},{"k":"op","op":"pow","args":[{"k":"id","name":"L"},{"k":"real","v":2}]}]},{"k":"real","v":8}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"25","left":180,"top":988.5,"alignX":180,"alignY":1004.5,"disabled":false,"content":{"k":"eval","expr":{"k":"id","name":"M"},"stored":null,"unit":{"k":"op","op":"mult","args":[{"k":"id","name":"N"},{"k":"id","name":"m"}]}}},{"id":"26","left":306,"top":984.5,"alignX":306,"alignY":1004.5,"disabled":false,"content":{"k":"define","target":{"k":"fn","name":"σ","params":["h"]},"value":{"k":"op","op":"div","args":[{"k":"op","op":"mult","args":[{"k":"id","name":"M"},{"k":"op","op":"div","args":[{"k":"id","name":"h"},{"k":"real","v":2}]}]},{"k":"call","fn":{"k":"id","name":"I"},"args":[{"k":"id","name":"h"}]}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"27","left":432,"top":988.5,"alignX":432,"alignY":1004.5,"disabled":false,"content":{"k":"eval","expr":{"k":"call","fn":{"k":"id","name":"σ"},"args":[{"k":"op","op":"mult","args":[{"k":"real","v":19},{"k":"id","name":"mm"}]}]},"stored":null,"unit":{"k":"id","name":"MPa"}}}],"texts":[{"id":"1","left":54,"top":72,"width":440,"height":40.5,"text":"How much does a bookshelf sag? A pine shelf rests on two brackets 900 mm apart and holds 50 kg of books. Beam theory gives the sag along it; we check it against a common limit and find how thick the board should be."},{"id":"2","left":54,"top":120.5,"width":440,"height":27,"text":"The shelf. E is the stiffness of pine along the grain, and the books are a load spread evenly along the span."},{"id":"11","left":54,"top":239.5,"width":440,"height":27,"text":"I is the second moment of area of the board's cross-section, which grows with the cube of its thickness h."},{"id":"12","left":54,"top":292.5,"width":440,"height":27,"text":"The sag. For a simply supported beam under an even load, the deflection at a distance x from one end is:"},{"id":"16","left":394,"top":441.5,"width":154,"height":60,"text":"Blue, a 19 mm board; green, 25 mm. A third more thickness more than halves the sag."},{"id":"17","left":54,"top":605.5,"width":440,"height":13.5,"text":"Too much? A common limit is a sag of 1/360 of the span. The middle sags most:"},{"id":"20","left":54,"top":864,"width":440,"height":13.5,"text":"Over the limit. root finds the thickness at which the sag in the middle is exactly L/360:"},{"id":"23","left":54,"top":949.5,"width":440,"height":27,"text":"Will it break? The bending stress is greatest at the middle, on the board's top and bottom faces."},{"id":"28","left":54,"top":1030.5,"width":440,"height":40.5,"text":"Pine breaks at around 40 MPa in bending, so the shelf is strong enough: stiffness, not strength, decides its thickness. Try it: change P, or L to 1200 mm, and see how fast the sag grows with the span."}],"opaque":[],"origin":0,"tol":0.001,"exactCompare":true,"zeroOverZero":false,"otherRegions":{},"componentOutputs":[]}}