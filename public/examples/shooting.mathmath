":"op","op":"indexer","args":[{"k":"id","name":"c"},{"k":"real","v":2}]}]}]},{"k":"op","op":"minus","args":[{"k":"op","op":"minus","args":[{"k":"op","op":"mult","args":[{"k":"real","v":0.04},{"k":"op","op":"indexer","args":[{"k":"id","name":"c"},{"k":"real","v":0}]}]},{"k":"op","op":"mult","args":[{"k":"op","op":"mult","args":[{"k":"op","op":"pow","args":[{"k":"real","v":10},{"k":"real","v":4}]},{"k":"op","op":"indexer","args":[{"k":"id","name":"c"},{"k":"real","v":1}]}]},{"k":"op","op":"indexer","args":[{"k":"id","name":"c"},{"k":"real","v":2}]}]}]},{"k":"op","op":"mult","args":[{"k":"op","op":"mult","args":[{"k":"real","v":3},{"k":"op","op":"pow","args":[{"k":"real","v":10},{"k":"real","v":7}]}]},{"k":"op","op":"pow","args":[{"k":"op","op":"indexer","args":[{"k":"id","name":"c"},{"k":"real","v":1}]},{"k":"real","v":2}]}]}]},{"k":"op","op":"mult","args":[{"k":"op","op":"mult","args":[{"k":"real","v":3},{"k":"op","op":"pow","args":[{"k":"real","v":10},{"k":"real","v":7}]}]},{"k":"op","op":"pow","args":[{"k":"op","op":"indexer","args":[{"k":"id","name":"c"},{"k":"real","v":1}]},{"k":"real","v":2}]}]}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"30","left":54,"top":1390.5,"alignX":54,"alignY":1420.5,"disabled":false,"content":{"k":"define","target":{"k":"fn","name":"J","params":["t","c"]},"value":{"k":"call","fn":{"k":"id","name":"augment"},"args":[{"k":"matrix","rows":3,"cols":1,"items":[{"k":"real","v":0},{"k":"real","v":0},{"k":"real","v":0}]},{"k":"call","fn":{"k":"id","name":"Jacob"},"args":[{"k":"call","fn":{"k":"id","name":"S"},"args":[{"k":"id","name":"t"},{"k":"id","name":"c"}]},{"k":"id","name":"c"}]}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"31","left":384,"top":1390.5,"alignX":384,"alignY":1420.5,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"Z"},"value":{"k":"call","fn":{"k":"id","name":"Stiffb"},"args":[{"k":"matrix","rows":3,"cols":1,"items":[{"k":"real","v":1},{"k":"real","v":0},{"k":"real","v":0}]},{"k":"real","v":0},{"k":"real","v":40},{"k":"real","v":4},{"k":"id","name":"S"},{"k":"id","name":"J"}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"32","left":54,"top":1656,"alignX":54,"alignY":1700,"disabled":false,"content":{"k":"eval","expr":{"k":"id","name":"Z"},"stored":null,"unit":null}},{"id":"34","left":54,"top":1798.5,"alignX":54,"alignY":1828.5,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"c"},"value":{"k":"matrix","rows":3,"cols":1,"items":[{"k":"real","v":1},{"k":"real","v":0},{"k":"real","v":0}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"35","left":204,"top":1798.5,"alignX":204,"alignY":1828.5,"disabled":false,"content":{"k":"eval","expr":{"k":"call","fn":{"k":"id","name":"Jacob"},"args":[{"k":"call","fn":{"k":"id","name":"S"},"args":[{"k":"real","v":0},{"k":"id","name":"c"}]},{"k":"id","name":"c"}]},"stored":null,"unit":null}}],"texts":[{"id":"1","left":54,"top":72,"width":440,"height":27,"text":"A circuit, a beam and a reaction: three kinds of differential equation, and the solvers that suit them."},{"id":"2","left":54,"top":107,"width":440,"height":54,"text":"A series RLC circuit switched onto 10 V at t = 0, its states the charge q and current i: q′ = i and i′ = (V − R·i − q/C)/L. That is linear, x′ = A·x + B·u, so statespace takes it as it is, with A, B and the input u as functions of time (in seconds, ohms, henries and farads, without units, as statespace takes them)."},{"id":"11","left":54,"top":439,"width":440,"height":27,"text":"The current rings at about 5 Hz, 1/(2π√(LC)), dying away as the resistor takes the energy, and the capacitor ends charged to 10 V:"},{"id":"14","left":54,"top":538,"width":440,"height":54,"text":"A beam 4 m long, resting on supports at both ends, under a uniform load. Its deflection y obeys y⁗ = w, the load over the stiffness of the beam, q/(E·I), with y = 0 and y″ = 0 at each end: two conditions at the start and two at the far end. Written as four first-order equations, the deflection, slope, curvature and its rate:"},{"id":"18","left":54,"top":864,"width":440,"height":40.5,"text":"sbval guesses the two unknown starting values, the slope y′ and y‴ at the left support, solves along the beam, and adjusts them until the far conditions hold. load fills in the known ones; score is 0 when the far end is right."},{"id":"25","left":54,"top":1190.5,"width":440,"height":13.5,"text":"It bends most at the middle, where the textbook gives 5·w·L⁴/384 for a span L:"},{"id":"28","left":54,"top":1276,"width":440,"height":40.5,"text":"A stiff reaction: Robertson's three chemicals, one changing a million times faster than another. The stiff solvers want the Jacobian of the equations; Jacob works it out from them, rather than by hand."},{"id":"33","left":54,"top":1750,"width":440,"height":40.5,"text":"The first column is time; by t = 40 more than a quarter of the first chemical has become the third, while the second never passes 2e−5. The Jacobian at the start, for comparison with the equations:"},{"id":"36","left":54,"top":1864.5,"width":440,"height":27,"text":"Try another load or span for the beam, or another resistor: R above 2√(L/C), about 32 Ω, stops the ringing."}],"opaque":[],"origin":0,"tol":0.001,"exactCompare":true,"zeroOverZero":false,"otherRegions":{},"componentOutputs":[]}}