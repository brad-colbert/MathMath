"name":"j"}]},"value":{"k":"op","op":"div","args":[{"k":"op","op":"mult","args":[{"k":"real","v":4},{"k":"call","fn":{"k":"id","name":"mod"},"args":[{"k":"op","op":"mult","args":[{"k":"real","v":5},{"k":"id","name":"j"}]},{"k":"real","v":11}]}]},{"k":"real","v":10}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"22","left":54,"top":687.5,"alignX":54,"alignY":703.5,"disabled":false,"content":{"k":"define","target":{"k":"index","name":"z","index":[{"k":"id","name":"j"}]},"value":{"k":"op","op":"plus","args":[{"k":"op","op":"mult","args":[{"k":"call","fn":{"k":"id","name":"sin"},"args":[{"k":"op","op":"indexer","args":[{"k":"id","name":"u"},{"k":"id","name":"j"}]}]},{"k":"call","fn":{"k":"id","name":"cos"},"args":[{"k":"op","op":"indexer","args":[{"k":"id","name":"v"},{"k":"id","name":"j"}]}]}]},{"k":"op","op":"mult","args":[{"k":"real","v":0.1},{"k":"call","fn":{"k":"id","name":"sin"},"args":[{"k":"op","op":"mult","args":[{"k":"real","v":2.3},{"k":"op","op":"pow","args":[{"k":"id","name":"j"},{"k":"real","v":2}]}]}]}]}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"23","left":306,"top":687.5,"alignX":306,"alignY":703.5,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"M"},"value":{"k":"call","fn":{"k":"id","name":"augment"},"args":[{"k":"id","name":"u"},{"k":"id","name":"v"}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"24","left":54,"top":871,"alignX":54,"alignY":887,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"C"},"value":{"k":"call","fn":{"k":"id","name":"loess"},"args":[{"k":"id","name":"M"},{"k":"id","name":"z"},{"k":"real","v":0.5}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"25","left":306,"top":864,"alignX":306,"alignY":887,"disabled":false,"content":{"k":"define","target":{"k":"fn","name":"S","params":["p","q"]},"value":{"k":"call","fn":{"k":"id","name":"interp"},"args":[{"k":"id","name":"C"},{"k":"id","name":"M"},{"k":"id","name":"z"},{"k":"matrix","rows":2,"cols":1,"items":[{"k":"id","name":"p"},{"k":"id","name":"q"}]}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"26","left":54,"top":932,"alignX":54,"alignY":932,"disabled":false,"content":{"k":"plot","x":null,"ys":[{"k":"id","name":"S"}],"markers":false,"width":240,"height":230,"xAxis":{"min":{"k":"real","v":0.05},"max":{"k":"real","v":3.95},"log":false},"yAxis":{"min":{"k":"real","v":0.05},"max":{"k":"real","v":3.95},"log":false},"view":"surface","colorMap":"viridis","title":"The fitted surface"}},{"id":"27","left":306,"top":932,"alignX":306,"alignY":932,"disabled":false,"content":{"k":"plot","x":null,"ys":[{"k":"id","name":"S"}],"markers":false,"width":240,"height":230,"xAxis":{"min":{"k":"real","v":0.05},"max":{"k":"real","v":3.95},"log":false},"yAxis":{"min":{"k":"real","v":0.05},"max":{"k":"real","v":3.95},"log":false},"view":"contour","title":"Its contours"}}],"texts":[{"id":"1","left":54,"top":72,"width":440,"height":40.5,"text":"Fitting by neighbourhoods. When no one formula suits the data, loess fits a quadratic to each neighbourhood of it, the nearest points counting most, and blends the pieces into a smooth curve. The noise here is made by formula, so the sheet gives the same numbers every time."},{"id":"2","left":54,"top":120.5,"width":440,"height":13.5,"text":"Sixty readings of a slow curve, with noise on each."},{"id":"7","left":54,"top":206,"width":440,"height":40.5,"text":"Two fits. span is the fraction of the points each local fit takes in: a quarter of them follows the curve closely, three quarters smooths more and cuts the corners. interp reads either fit anywhere within the data."},{"id":"13","left":384,"top":322.5,"width":164,"height":60,"text":"Gray: the readings. Blue: span 0.25. Orange: span 0.75. Dashed: the curve they came from."},{"id":"14","left":54,"top":488.5,"width":440,"height":40.5,"text":"The vector loess returns holds the whole fit. Near its end is the residual standard error, an estimate of the noise, which was 0.3·sin(…), about 0.21 in size. Span 0.25 comes close; span 0.75 counts the corners it cut as noise too."},{"id":"18","left":54,"top":593,"width":440,"height":40.5,"text":"A surface. loess takes up to four variables, as the columns of a matrix. Here 60 points scattered over a square, with a height measured at each; interp gives the fitted surface at any point inside them."},{"id":"28","left":54,"top":1188,"width":440,"height":27,"text":"The heights came from sin(u)·cos(v) plus noise: a hill near u = π/2, v = 0 and a hollow near v = π. The fit finds both from 60 noisy points."}],"opaque":[],"origin":0,"tol":0.001,"exactCompare":true,"zeroOverZero":false,"otherRegions":{},"componentOutputs":[]}}