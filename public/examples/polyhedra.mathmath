{"format":"mathmath","version":1,"worksheet":{"page":{"width":612,"height":792,"landscape":false,"margins":{"left":36,"right":36,"top":36,"bottom":36}},"format":{"precision":4,"exponent":5,"trailingZeros":false},"assets":{},"regions":[{"id":"2","left":54,"top":134,"alignX":54,"alignY":150,"disabled":false,"content":{"k":"eval","expr":{"k":"call","fn":{"k":"id","name":"PolyLookup"},"args":[{"k":"real","v":34}]},"stored":null,"unit":null}},{"id":"4","left":54,"top":236.5,"alignX":54,"alignY":236.5,"disabled":false,"content":{"k":"plot","x":null,"ys":[{"k":"call","fn":{"k":"id","name":"Polyhedron"},"args":[{"k":"str","v":"snub dodecahedron"}]}],"markers":false,"width":230,"height":230,"xAxis":{"min":null,"max":null,"log":false},"yAxis":{"min":null,"max":null,"log":false},"view":"surface","colorMap":"viridis"}},{"id":"5","left":306,"top":236.5,"alignX":306,"alignY":236.5,"disabled":false,"content":{"k":"plot","x":null,"ys":[{"k":"call","fn":{"k":"id","name":"Polyhedron"},"args":[{"k":"str","v":"pentagonal hexecontahedron"}]}],"markers":false,"width":230,"height":230,"xAxis":{"min":null,"max":null,"log":false},"yAxis":{"min":null,"max":null,"log":false},"view":"surface"}},{"id":"8","left":54,"top":864,"alignX":54,"alignY":864,"disabled":false,"content":{"k":"plot","x":null,"ys":[{"k":"call","fn":{"k":"id","name":"Polyhedron"},"args":[{"k":"str","v":"3|2 5/2"}]}],"markers":false,"width":230,"height":230,"xAxis":{"min":null,"max":null,"log":false},"yAxis":{"min":null,"max":null,"log":false},"view":"surface"}},{"id":"9","left":306,"top":864,"alignX":306,"alignY":864,"disabled":false,"content":{"k":"plot","x":null,"ys":[{"k":"call","fn":{"k":"id","name":"Polyhedron"},"args":[{"k":"str","v":"#80"}]}],"markers":false,"width":230,"height":230,"xAxis":{"min":null,"max":null,"log":false},"yAxis":{"min":null,"max":null,"log":false},"view":"surface","colorMap":"spectrum"}},{"id":"12","left":54,"top":1194.5,"alignX":54,"alignY":1210.5,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"n"},"value":{"k":"real","v":62},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"13","left":174,"top":1194.5,"alignX":174,"alignY":1210.5,"disabled":false,"content":{"k":"eval","expr":{"k":"call","fn":{"k":"id","name":"PolyLookup"},"args":[{"k":"id","name":"n"}]},"stored":null,"unit":null}},{"id":"14","left":54,"top":1248.5,"alignX":54,"alignY":1264.5,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"S"},"value":{"k":"call","fn":{"k":"id","name":"concat"},"args":[{"k":"str","v":"#"},{"k":"call","fn":{"k":"id","name":"num2str"},"args":[{"k":"id","name":"n"}]}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"15","left":314,"top":1248.5,"alignX":314,"alignY":1264.5,"disabled":false,"content":{"k":"eval","expr":{"k":"id","name":"S"},"stored":null,"unit":null}},{"id":"16","left":54,"top":1656,"alignX":54,"alignY":1656,"disabled":false,"content":{"k":"plot","x":null,"ys":[{"k":"id","name":"S"}],"markers":false,"width":260,"height":240,"xAxis":{"min":null,"max":null,"log":false},"yAxis":{"min":null,"max":null,"log":false},"view":"surface"}}],"texts":[{"id":"1","left":54,"top":72,"width":440,"height":54,"text":"A uniform polyhedron has regular faces and every vertex alike. There are 80 of them, as Mathcad numbers them: the five Platonic solids, the thirteen Archimedean ones, prisms and antiprisms, and 57 stars whose faces pass through each other. Each has a name, a dual and a Wythoff symbol, which PolyLookup gives."},{"id":"3","left":54,"top":188,"width":440,"height":40.5,"text":"Polyhedron draws one in a surface plot, by its name, its dual's name, its number or its Wythoff symbol. Drag a plot to turn it. In a colour map, each kind of face has its own colour: here the snub dodecahedron's triangles and pentagons."},{"id":"6","left":54,"top":492.5,"width":440,"height":27,"text":"The second is the snub dodecahedron's dual: a face for each of its vertices, and a vertex for each of its faces."},{"id":"7","left":54,"top":545.5,"width":440,"height":54,"text":"The Wythoff symbol says how the polyhedron is built. Its numbers p, q and r make a triangle on a sphere with angles π/p, π/q and π/r, and mirrors on its sides multiply it over the sphere; the bar says where in the triangle the first vertex sits. In 3|2 5/2 it sits at the corner with angle π/3, and 5/2, a pentagram's angle, makes a star: the great stellated dodecahedron."},{"id":"10","left":54,"top":1120,"width":440,"height":27,"text":"Number 80, the great dirhombicosidodecahedron, is the one whose symbol has four numbers: no triangle builds it. Its 60 squares all pass through the centre."},{"id":"11","left":54,"top":1173,"width":440,"height":13.5,"text":"Any of the 80 by number: change n."},{"id":"17","left":54,"top":1922,"width":440,"height":27,"text":"The plot draws the polyhedron its string names, so a string built from n draws it too; Polyhedron(S) would give the same."}],"opaque":[],"origin":0,"tol":0.001,"exactCompare":true,"zeroOverZero":false,"otherRegions":{},"componentOutputs":[]}}