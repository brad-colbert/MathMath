"top":1978.5,"alignX":424,"alignY":1998.5,"disabled":false,"content":{"k":"define","target":{"k":"index","name":"ϕ","index":[{"k":"id","name":"k"}]},"value":{"k":"op","op":"mult","args":[{"k":"op","op":"mult","args":[{"k":"real","v":2},{"k":"id","name":"π"}]},{"k":"op","op":"div","args":[{"k":"call","fn":{"k":"id","name":"mod"},"args":[{"k":"id","name":"k"},{"k":"id","name":"N"}]},{"k":"id","name":"N"}]}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"21","left":54,"top":2040.5,"alignX":54,"alignY":2056.5,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"Sx"},"value":{"k":"op","op":"vectorize","args":[{"k":"op","op":"mult","args":[{"k":"call","fn":{"k":"id","name":"sin"},"args":[{"k":"id","name":"θ"}]},{"k":"call","fn":{"k":"id","name":"cos"},"args":[{"k":"id","name":"ϕ"}]}]}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"22","left":234,"top":2040.5,"alignX":234,"alignY":2056.5,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"Sy"},"value":{"k":"op","op":"vectorize","args":[{"k":"op","op":"mult","args":[{"k":"call","fn":{"k":"id","name":"sin"},"args":[{"k":"id","name":"θ"}]},{"k":"call","fn":{"k":"id","name":"sin"},"args":[{"k":"id","name":"ϕ"}]}]}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"23","left":414,"top":2040.5,"alignX":414,"alignY":2056.5,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"Sz"},"value":{"k":"op","op":"vectorize","args":[{"k":"call","fn":{"k":"id","name":"cos"},"args":[{"k":"id","name":"θ"}]}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"24","left":54,"top":2448,"alignX":54,"alignY":2448,"disabled":false,"content":{"k":"plot","x":null,"ys":[{"k":"id","name":"Sx"},{"k":"id","name":"Sy"},{"k":"id","name":"Sz"},{"k":"id","name":"Sx"},{"k":"id","name":"Sy"},{"k":"id","name":"Sz"}],"markers":false,"width":280,"height":260,"xAxis":{"min":null,"max":null,"log":false},"yAxis":{"min":null,"max":null,"log":false},"view":"vector"}}],"texts":[{"id":"1","left":54,"top":72,"width":440,"height":27,"text":"A vector field plot draws an arrow at each point, its length in proportion, the longest reaching the next point. Choose it from Format → Vector field plot."},{"id":"2","left":54,"top":107,"width":440,"height":40.5,"text":"A whirlpool, written as Mathcad writes a field: a matrix of complex numbers, the real part across and the imaginary part up, row i at x = i and column j at y = j. Water spirals in towards the middle: inward, and round."},{"id":"7","left":54,"top":553.5,"width":440,"height":40.5,"text":"A pendulum's phase portrait: at angle θ and angular speed ω, the state moves at (ω, −sin θ). A function of two variables giving the two parts is sampled over the limits below the plot. In a colour map, each arrow is colored by its length: the swing is fastest at the bottom."},{"id":"10","left":54,"top":1130,"width":440,"height":27,"text":"Round the bottom, at θ = 0 and its turns 2π, the arrows circle: the pendulum swings back and forth. Near θ = ±π, the top, they part: it falls one way or the other."},{"id":"11","left":54,"top":1183,"width":440,"height":27,"text":"The gradient of a hill: ∇h, the parts ∂h/∂x and ∂h/∂y, points the way h rises fastest, and crosses its level curves at right angles."},{"id":"16","left":54,"top":1930,"width":440,"height":40.5,"text":"Arrows in space: six arrays typed with commas, the points X, Y and Z and the arrows' parts U, V and W. Here, points on a sphere with the arrows pointing straight out, as from a source; drag the plot to turn it."},{"id":"25","left":54,"top":2734,"width":440,"height":27,"text":"The same points can carry any field: swap the last three for −Sy, Sx and 0 and the arrows swirl round the vertical axis instead."}],"opaque":[],"origin":0,"tol":0.001,"exactCompare":true,"zeroOverZero":false,"otherRegions":{},"componentOutputs":[]}}