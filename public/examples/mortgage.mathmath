:null,"unit":null,"shown":false}},{"id":"25","left":254,"top":899,"alignX":254,"alignY":919,"disabled":false,"content":{"k":"eval","expr":{"k":"op","op":"div","args":[{"k":"id","name":"N"},{"k":"real","v":12}]},"stored":null,"unit":null}},{"id":"26","left":354,"top":903,"alignX":354,"alignY":919,"disabled":false,"content":{"k":"eval","expr":{"k":"op","op":"minus","args":[{"k":"op","op":"mult","args":[{"k":"op","op":"minus","args":[{"k":"id","name":"M"},{"k":"real","v":200}]},{"k":"id","name":"N"}]},{"k":"op","op":"mult","args":[{"k":"id","name":"M"},{"k":"id","name":"n"}]}]},"stored":null,"unit":null}},{"id":"28","left":54,"top":993.5,"alignX":54,"alignY":1013.5,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"M.15"},"value":{"k":"call","fn":{"k":"id","name":"pmt"},"args":[{"k":"op","op":"div","args":[{"k":"op","op":"mult","args":[{"k":"real","v":5.75},{"k":"id","name":"%"}]},{"k":"real","v":12}]},{"k":"real","v":180},{"k":"id","name":"P"}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"29","left":274,"top":997.5,"alignX":274,"alignY":1013.5,"disabled":false,"content":{"k":"eval","expr":{"k":"id","name":"M.15"},"stored":null,"unit":null}},{"id":"30","left":394,"top":997.5,"alignX":394,"alignY":1013.5,"disabled":false,"content":{"k":"eval","expr":{"k":"op","op":"mult","args":[{"k":"real","v":12},{"k":"call","fn":{"k":"id","name":"rate"},"args":[{"k":"real","v":180},{"k":"id","name":"M.15"},{"k":"id","name":"P"}]}]},"stored":null,"unit":{"k":"id","name":"%"}}},{"id":"31","left":54,"top":1039.5,"alignX":54,"alignY":1059.5,"disabled":false,"content":{"k":"eval","expr":{"k":"call","fn":{"k":"id","name":"cumint"},"args":[{"k":"op","op":"div","args":[{"k":"op","op":"mult","args":[{"k":"real","v":5.75},{"k":"id","name":"%"}]},{"k":"real","v":12}]},{"k":"real","v":180},{"k":"id","name":"P"},{"k":"real","v":1},{"k":"real","v":180}]},"stored":null,"unit":null}},{"id":"34","left":54,"top":1173.5,"alignX":54,"alignY":1189.5,"disabled":false,"content":{"k":"define","target":{"k":"index","name":"c","index":[{"k":"real","v":0}]},"value":{"k":"real","v":-14000},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"35","left":222,"top":1173.5,"alignX":222,"alignY":1189.5,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"j"},"value":{"k":"range","first":{"k":"real","v":1},"second":null,"last":{"k":"real","v":20}},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"36","left":390,"top":1173.5,"alignX":390,"alignY":1189.5,"disabled":false,"content":{"k":"define","target":{"k":"index","name":"c","index":[{"k":"id","name":"j"}]},"value":{"k":"op","op":"mult","args":[{"k":"real","v":1400},{"k":"op","op":"pow","args":[{"k":"real","v":1.03},{"k":"op","op":"minus","args":[{"k":"id","name":"j"},{"k":"real","v":1}]}]}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"37","left":54,"top":1211.5,"alignX":54,"alignY":1227.5,"disabled":false,"content":{"k":"eval","expr":{"k":"call","fn":{"k":"id","name":"irr"},"args":[{"k":"id","name":"c"}]},"stored":null,"unit":{"k":"id","name":"%"}}},{"id":"38","left":254,"top":1211.5,"alignX":254,"alignY":1227.5,"disabled":false,"content":{"k":"eval","expr":{"k":"op","op":"mult","args":[{"k":"call","fn":{"k":"id","name":"npv"},"args":[{"k":"op","op":"mult","args":[{"k":"real","v":6.5},{"k":"id","name":"%"}]},{"k":"id","name":"c"}]},{"k":"op","op":"plus","args":[{"k":"real","v":1},{"k":"op","op":"mult","args":[{"k":"real","v":6.5},{"k":"id","name":"%"}]}]}]},"stored":null,"unit":null}}],"texts":[{"id":"1","left":54,"top":72,"width":440,"height":40.5,"text":"A mortgage, month by month. A loan of 320 000 at 6.5% a year, repaid monthly over 30 years. The finance functions follow the spreadsheet signs: money received, as the loan, is positive, and money paid out negative."},{"id":"2","left":54,"top":120.5,"width":440,"height":27,"text":"The loan, and the monthly payment. The rate is per period, so the yearly rate is divided by 12."},{"id":"8","left":54,"top":201.5,"width":440,"height":13.5,"text":"Over the 30 years, the interest comes to more than the loan itself:"},{"id":"11","left":54,"top":279,"width":440,"height":40.5,"text":"Where each payment goes. ipmt is the part of a month's payment that is interest and ppmt the part that pays down the loan; together they are the payment. Early on, most of it is interest."},{"id":"22","left":54,"top":579.5,"width":440,"height":27,"text":"Left: each month's interest, red, and principal, blue; they cross after about 19 and a half years. Right: what is still owed."},{"id":"23","left":54,"top":864,"width":440,"height":27,"text":"Paying 200 more each month. nper finds how long the loan then lasts, and the interest saved follows."},{"id":"27","left":54,"top":945,"width":440,"height":40.5,"text":"Nearly seven years sooner, and more than 100 000 less interest. A 15-year loan, which usually comes at a lower rate, does better still. rate goes the other way, from a payment back to the rate:"},{"id":"32","left":54,"top":1085.5,"width":440,"height":13.5,"text":"A higher payment, but well under half the interest of the 30-year loan."},{"id":"33","left":54,"top":1125,"width":440,"height":40.5,"text":"Solar panels on the roof: 14 000 now, then savings of 1400 the first year, rising 3% a year with the price of power, for 20 years. irr is the return they earn; npv, at the 6.5% the mortgage costs, says whether they beat paying it down."},{"id":"39","left":54,"top":1249.5,"width":440,"height":40.5,"text":"npv counts the first flow a year ahead, so multiplying by 1.065 brings it back to now. The panels return about 10.6% a year, and are worth some 5500 more than putting the money against the loan. Try 2% for the rise in the price of power."}],"opaque":[],"origin":0,"tol":0.001,"exactCompare":true,"zeroOverZero":false,"otherRegions":{},"componentOutputs":[]}}