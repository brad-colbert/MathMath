:354,"alignY":1394,"disabled":false,"content":{"k":"eval","expr":{"k":"op","op":"divergence","args":[{"k":"call","fn":{"k":"id","name":"v"},"args":[{"k":"real","v":1},{"k":"real","v":-2},{"k":"real","v":0.5}]}]},"stored":null,"unit":null}},{"id":"30","left":54,"top":1704.5,"alignX":54,"alignY":1727.5,"disabled":false,"content":{"k":"define","target":{"k":"fn","name":"w","params":["x","y"]},"value":{"k":"op","op":"div","args":[{"k":"matrix","rows":2,"cols":1,"items":[{"k":"op","op":"neg","args":[{"k":"id","name":"y"}]},{"k":"id","name":"x"}]},{"k":"op","op":"plus","args":[{"k":"op","op":"pow","args":[{"k":"id","name":"x"},{"k":"real","v":2}]},{"k":"op","op":"pow","args":[{"k":"id","name":"y"},{"k":"real","v":2}]}]}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"31","left":254,"top":1711.5,"alignX":254,"alignY":1727.5,"disabled":false,"content":{"k":"eval","expr":{"k":"op","op":"curl","args":[{"k":"call","fn":{"k":"id","name":"w"},"args":[{"k":"real","v":0.5},{"k":"real","v":1}]}]},"stored":null,"unit":null}},{"id":"32","left":54,"top":1772.5,"alignX":54,"alignY":1788.5,"disabled":false,"content":{"k":"sym","target":null,"global":false,"expr":{"k":"op","op":"curl","args":[{"k":"call","fn":{"k":"id","name":"w"},"args":[{"k":"id","name":"x"},{"k":"id","name":"y"}]}]},"commands":[{"name":"simplify","args":[]}],"stored":null}},{"id":"34","left":54,"top":1893,"alignX":54,"alignY":1909,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"c"},"value":{"k":"real","v":2},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"35","left":124,"top":1893,"alignX":124,"alignY":1909,"disabled":false,"content":{"k":"define","target":{"k":"fn","name":"u","params":["x","t"]},"value":{"k":"call","fn":{"k":"id","name":"sin"},"args":[{"k":"op","op":"minus","args":[{"k":"id","name":"x"},{"k":"op","op":"mult","args":[{"k":"id","name":"c"},{"k":"id","name":"t"}]}]}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"36","left":294,"top":1893,"alignX":294,"alignY":1909,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"x"},"value":{"k":"real","v":0.7},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"37","left":374,"top":1893,"alignX":374,"alignY":1909,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"t"},"value":{"k":"real","v":0.3},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"38","left":54,"top":1943,"alignX":54,"alignY":1963,"disabled":false,"content":{"k":"eval","expr":{"k":"derivative","varName":"t","body":{"k":"call","fn":{"k":"id","name":"u"},"args":[{"k":"id","name":"x"},{"k":"id","name":"t"}]},"partial":true,"degree":{"k":"real","v":2}},"stored":null,"unit":null}},{"id":"39","left":254,"top":1943,"alignX":254,"alignY":1963,"disabled":false,"content":{"k":"eval","expr":{"k":"op","op":"mult","args":[{"k":"op","op":"pow","args":[{"k":"id","name":"c"},{"k":"real","v":2}]},{"k":"derivative","varName":"x","body":{"k":"call","fn":{"k":"id","name":"u"},"args":[{"k":"id","name":"x"},{"k":"id","name":"t"}]},"partial":true,"degree":{"k":"real","v":2}}]},"stored":null,"unit":null}},{"id":"41","left":54,"top":2026.5,"alignX":54,"alignY":2046.5,"disabled":false,"content":{"k":"eval","expr":{"k":"derivative","varName":"x","body":{"k":"derivative","varName":"t","body":{"k":"call","fn":{"k":"id","name":"u"},"args":[{"k":"id","name":"x"},{"k":"id","name":"t"}]},"partial":true},"partial":true},"stored":null,"unit":null}},{"id":"42","left":254,"top":2030.5,"alignX":254,"alignY":2046.5,"disabled":false,"content":{"k":"eval","expr":{"k":"op","op":"mult","args":[{"k":"id","name":"c"},{"k":"call","fn":{"k":"id","name":"sin"},"args":[{"k":"op","op":"minus","args":[{"k":"id","name":"x"},{"k":"op","op":"mult","args":[{"k":"id","name":"c"},{"k":"id","name":"t"}]}]}]}]},"stored":null,"unit":null}}],"texts":[{"id":"1","left":54,"top":72,"width":440,"height":40.5,"text":"∇ goes before a function and its arguments, and differentiates in each argument in turn: ∇f(x, y, z) is the gradient, ∇·F the divergence, ∇×F the curl and ∇²f the Laplacian. They are in the ∇ menu on the toolbar, with ∂/∂x and the hats of î, ĵ and k̂."},{"id":"2","left":54,"top":120.5,"width":440,"height":27,"text":"Two charges, +1 at (−1, 0, 0) and −1 at (1, 0, 0). The potential is the sum of q/r for each; the field, the force on a small positive charge, is E = −∇V."},{"id":"8","left":54,"top":295.5,"width":440,"height":27,"text":"Halfway between, the field points from + to −, along x. Above the middle it is weaker, and still along x: the two charges' pulls up and down cancel."},{"id":"14","left":54,"top":626.5,"width":440,"height":40.5,"text":"Each arrow is E divided by its length, so it shows only the way the field points: out of the + charge, round, and into the −. The lines of equal V cross the arrows at right angles, as a gradient's do."},{"id":"15","left":54,"top":864,"width":440,"height":40.5,"text":"Away from the charges, the field has no sources and doesn't turn: its divergence and curl are zero, and V is harmonic, its Laplacian zero. Here at (0.3, 0.4, 0.2), zero to the accuracy of the differences ∇ takes."},{"id":"19","left":54,"top":1042.5,"width":440,"height":27,"text":"With →, ∇ works exactly. The potential of one charge, 1/r, is harmonic everywhere but at the charge itself:"},{"id":"23","left":54,"top":1225.5,"width":440,"height":40.5,"text":"A spinning body. Turning at angular velocity ω, a vector along its axis, a point at (x, y, z) moves at ω × (x, y, z). Its curl is 2ω everywhere, and its divergence zero: it turns, and nothing is squeezed. î, ĵ and k̂ are the unit vectors."},{"id":"29","left":54,"top":1656,"width":440,"height":40.5,"text":"In the plane, ∇× of a field of two parts is a number, the turning about the axis out of the page. A whirl that slows with distance, like water round a drain, turns nowhere but at the middle:"},{"id":"33","left":54,"top":1844.5,"width":440,"height":40.5,"text":"Partial derivatives. A wave moving at speed c, u(x, t) = sin(x − ct), satisfies the wave equation ∂²u/∂t² = c² ∂²u/∂x². ∂/∂x works as d/dx does, holding the other variables at their values."},{"id":"40","left":54,"top":2005,"width":440,"height":13.5,"text":"Two in a row, in different variables, show as one: ∂/∂x of ∂/∂t of u."},{"id":"43","left":54,"top":2072.5,"width":440,"height":13.5,"text":"Change the charges, or move the point, and everything below follows."}],"opaque":[],"origin":0,"tol":0.001,"exactCompare":true,"zeroOverZero":false,"otherRegions":{},"componentOutputs":[]}}