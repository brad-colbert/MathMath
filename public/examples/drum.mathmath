":"op","op":"div","args":[{"k":"op","op":"mult","args":[{"k":"id","name":"z.01"},{"k":"op","op":"absval","args":[{"k":"id","name":"r"}]}]},{"k":"id","name":"a"}]}]},{"k":"call","fn":{"k":"id","name":"Jn"},"args":[{"k":"real","v":1},{"k":"op","op":"div","args":[{"k":"op","op":"mult","args":[{"k":"id","name":"z.11"},{"k":"id","name":"r"}]},{"k":"id","name":"a"}]}]},{"k":"call","fn":{"k":"id","name":"J0"},"args":[{"k":"op","op":"div","args":[{"k":"op","op":"mult","args":[{"k":"id","name":"z.02"},{"k":"op","op":"absval","args":[{"k":"id","name":"r"}]}]},{"k":"id","name":"a"}]}]}],"markers":false,"width":300,"height":150,"xAxis":{"min":null,"max":null,"log":false,"unit":{"k":"id","name":"cm"}},"yAxis":{"min":null,"max":null,"log":false},"traces":[{"color":"#2563eb","weight":2},{"color":"#d97706","weight":2},{"color":"#16a34a","weight":2}]}},{"id":"27","left":54,"top":1110.5,"alignX":54,"alignY":1126.5,"disabled":false,"content":{"k":"eval","expr":{"k":"call","fn":{"k":"id","name":"Γ"},"args":[{"k":"real","v":5}]},"stored":null,"unit":null}},{"id":"28","left":154,"top":1110.5,"alignX":154,"alignY":1126.5,"disabled":false,"content":{"k":"eval","expr":{"k":"op","op":"pow","args":[{"k":"call","fn":{"k":"id","name":"Γ"},"args":[{"k":"real","v":0.5}]},{"k":"real","v":2}]},"stored":null,"unit":null}},{"id":"29","left":284,"top":1106.5,"alignX":284,"alignY":1126.5,"disabled":false,"content":{"k":"define","target":{"k":"fn","name":"V","params":["n"]},"value":{"k":"op","op":"div","args":[{"k":"op","op":"pow","args":[{"k":"id","name":"π"},{"k":"op","op":"div","args":[{"k":"id","name":"n"},{"k":"real","v":2}]}]},{"k":"call","fn":{"k":"id","name":"Γ"},"args":[{"k":"op","op":"plus","args":[{"k":"op","op":"div","args":[{"k":"id","name":"n"},{"k":"real","v":2}]},{"k":"real","v":1}]}]}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"30","left":434,"top":1110.5,"alignX":434,"alignY":1126.5,"disabled":false,"content":{"k":"eval","expr":{"k":"call","fn":{"k":"id","name":"V"},"args":[{"k":"real","v":3}]},"stored":null,"unit":null}},{"id":"31","left":54,"top":1156.5,"alignX":54,"alignY":1172.5,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"n"},"value":{"k":"range","first":{"k":"real","v":0},"second":null,"last":{"k":"real","v":20}},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"32","left":222,"top":1152.5,"alignX":222,"alignY":1172.5,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"n.max"},"value":{"k":"call","fn":{"k":"id","name":"root"},"args":[{"k":"derivative","varName":"u","body":{"k":"call","fn":{"k":"id","name":"V"},"args":[{"k":"id","name":"u"}]}},{"k":"id","name":"u"},{"k":"real","v":4},{"k":"real","v":6}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"33","left":434,"top":1156.5,"alignX":434,"alignY":1172.5,"disabled":false,"content":{"k":"eval","expr":{"k":"id","name":"n.max"},"stored":null,"unit":null}},{"id":"34","left":54,"top":1198.5,"alignX":54,"alignY":1198.5,"disabled":false,"content":{"k":"plot","x":{"k":"id","name":"n"},"ys":[{"k":"call","fn":{"k":"id","name":"V"},"args":[{"k":"id","name":"n"}]}],"markers":false,"width":300,"height":150,"xAxis":{"min":null,"max":null,"log":false},"yAxis":{"min":null,"max":null,"log":false},"traces":[{"color":"#2563eb","line":"solid","weight":2,"points":"circle"}]}}],"texts":[{"id":"1","left":54,"top":72,"width":440,"height":40.5,"text":"A drumhead and Bessel functions. A string vibrates at whole multiples of its lowest frequency, which is why it sounds a clear note. A round drumhead does not: its modes are set by the zeros of Bessel functions, and those aren't evenly spaced."},{"id":"2","left":54,"top":120.5,"width":440,"height":27,"text":"Bessel functions of the first kind: J0, and Jn(n, x) for J1 and J2. Each wobbles like a cosine whose swing dies away as 1/√x; J0 is 1 at the centre, and the others start at 0."},{"id":"7","left":384,"top":223.5,"width":164,"height":60,"text":"Blue J0, orange J1, gray J2. The drum's edge is held still, so a mode has to put a zero of J at the rim."},{"id":"8","left":54,"top":397.5,"width":440,"height":27,"text":"The drum: a 30 cm head, its tension τ per unit length and its mass σ per unit area set the speed waves cross it."},{"id":"14","left":54,"top":478.5,"width":440,"height":27,"text":"root finds the first zeros, each from an interval it lies in. Mode (0, 1) bulges as a whole, (1, 1) rocks side to side with one still line across it, and (0, 2) has a still ring:"},{"id":"22","left":54,"top":597.5,"width":440,"height":27,"text":"The overtones sit at 1.59 and 2.30 times the fundamental, not 2 and 3. That is the drum's thud. The shapes, across a diameter from the rim through the centre to the rim:"},{"id":"25","left":384,"top":894,"width":164,"height":60,"text":"Blue (0, 1), orange (1, 1), green (0, 2). J1 is odd, so (1, 1) goes up on one side as it goes down on the other."},{"id":"26","left":54,"top":1058,"width":440,"height":40.5,"text":"Γ, the factorial for any number. Γ(n + 1) = n!, and Γ(1/2) is √π. It gives the volume of a ball of radius 1 in n dimensions, which grows, peaks near five dimensions, and then shrinks towards nothing."},{"id":"35","left":384,"top":1228.5,"width":164,"height":60,"text":"V(3) is 4π/3, the sphere we know. Treating n as any real number, the peak is at 5.26 dimensions."}],"opaque":[],"origin":0,"tol":0.001,"exactCompare":true,"zeroOverZero":false,"otherRegions":{},"componentOutputs":[]}}