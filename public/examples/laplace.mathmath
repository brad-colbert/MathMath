864,"disabled":false,"content":{"k":"plot","x":{"k":"op","op":"matcol","args":[{"k":"id","name":"S"},{"k":"real","v":0}]},"ys":[{"k":"op","op":"vectorize","args":[{"k":"call","fn":{"k":"id","name":"x"},"args":[{"k":"op","op":"matcol","args":[{"k":"id","name":"S"},{"k":"real","v":0}]}]}]},{"k":"op","op":"matcol","args":[{"k":"id","name":"S"},{"k":"real","v":1}]}],"markers":false,"width":280,"height":150,"xAxis":{"min":null,"max":null,"log":false},"yAxis":{"min":null,"max":null,"log":false},"traces":[{"color":"#2563eb","weight":2},{"color":"#dc2626","line":"none","points":"circle"}]}},{"id":"25","left":54,"top":1075,"alignX":54,"alignY":1095,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"t.p"},"value":{"k":"call","fn":{"k":"id","name":"root"},"args":[{"k":"derivative","varName":"t","body":{"k":"call","fn":{"k":"id","name":"x"},"args":[{"k":"id","name":"t"}]}},{"k":"id","name":"t"},{"k":"real","v":1},{"k":"real","v":2}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"26","left":304,"top":1079,"alignX":304,"alignY":1095,"disabled":false,"content":{"k":"eval","expr":{"k":"id","name":"t.p"},"stored":null,"unit":null}},{"id":"27","left":434,"top":1079,"alignX":434,"alignY":1095,"disabled":false,"content":{"k":"eval","expr":{"k":"call","fn":{"k":"id","name":"x"},"args":[{"k":"id","name":"t.p"}]},"stored":null,"unit":null}},{"id":"28","left":54,"top":1121,"alignX":54,"alignY":1137,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"err"},"value":{"k":"op","op":"vectorize","args":[{"k":"op","op":"absval","args":[{"k":"op","op":"minus","args":[{"k":"call","fn":{"k":"id","name":"x"},"args":[{"k":"op","op":"matcol","args":[{"k":"id","name":"S"},{"k":"real","v":0}]}]},{"k":"op","op":"matcol","args":[{"k":"id","name":"S"},{"k":"real","v":1}]}]}]}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"29","left":304,"top":1121,"alignX":304,"alignY":1137,"disabled":false,"content":{"k":"eval","expr":{"k":"call","fn":{"k":"id","name":"max"},"args":[{"k":"id","name":"err"}]},"stored":null,"unit":null}}],"texts":[{"id":"1","left":54,"top":72,"width":440,"height":40.5,"text":"Exact answers: calculus and Laplace. Press Ctrl+. for →, and MathMath answers in symbols rather than numbers. A keyword before the arrow says what to do. Then the Laplace transform solves a differential equation exactly."},{"id":"2","left":54,"top":120.5,"width":440,"height":13.5,"text":"Calculus. A derivative, an integral to infinity, a limit and a Taylor series:"},{"id":"7","left":54,"top":234,"width":440,"height":27,"text":"And algebra: factor a polynomial, and solve an equation for one letter in terms of the others, here the distance d to speed up from u to v."},{"id":"10","left":54,"top":325,"width":440,"height":40.5,"text":"A spring and a damper. A 1 kg mass on a spring of stiffness 5 N/m, with a damper of 2 N·s/m, is pushed by a steady 5 N from t = 0. Its position obeys x″ + 2·x′ + 5·x = 5, starting at rest."},{"id":"11","left":54,"top":373.5,"width":440,"height":27,"text":"The Laplace transform turns each derivative into a factor of s, so the differential equation becomes algebra. Starting from rest, the transform of the position is:"},{"id":"14","left":54,"top":454.5,"width":440,"height":13.5,"text":"invlaplace turns it back into a function of time, and defines x(t) with the answer:"},{"id":"16","left":54,"top":514,"width":440,"height":13.5,"text":"Where it settles, by the final value theorem, and x at one second, now an ordinary function:"},{"id":"19","left":54,"top":591.5,"width":440,"height":27,"text":"Check it numerically. rkfixed solves the same equation step by step, from the state (position; velocity)."},{"id":"23","left":374,"top":894,"width":174,"height":60,"text":"The exact answer, blue, through the numerical steps, red: they agree. The mass overshoots, rings and settles at 1."},{"id":"24","left":54,"top":1040,"width":440,"height":27,"text":"The overshoot peaks where the velocity is zero, and the largest difference between the two answers is tiny:"},{"id":"30","left":54,"top":1159,"width":440,"height":13.5,"text":"Try it: make the damper 6 instead of 2, in X and in D, and the ringing stops."}],"opaque":[],"origin":0,"tol":0.001,"exactCompare":true,"zeroOverZero":false,"otherRegions":{},"componentOutputs":[]}}