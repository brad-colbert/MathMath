arget":{"k":"fn","name":"one","params":["a","b"]},"value":{"k":"real","v":1},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"41","left":204,"top":1656,"alignX":204,"alignY":1676,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"B"},"value":{"k":"call","fn":{"k":"id","name":"correl2d"},"args":[{"k":"id","name":"S"},{"k":"op","op":"div","args":[{"k":"call","fn":{"k":"id","name":"matrix"},"args":[{"k":"real","v":5},{"k":"real","v":5},{"k":"id","name":"one"}]},{"k":"real","v":25}]}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"42","left":54,"top":1702,"alignX":54,"alignY":1718,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"D"},"value":{"k":"call","fn":{"k":"id","name":"correl2d"},"args":[{"k":"id","name":"S"},{"k":"matrix","rows":1,"cols":3,"items":[{"k":"real","v":-1},{"k":"real","v":0},{"k":"real","v":1}]}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"43","left":304,"top":1702,"alignX":304,"alignY":1718,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"E"},"value":{"k":"op","op":"vectorize","args":[{"k":"op","op":"absval","args":[{"k":"id","name":"D"}]}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"44","left":54,"top":1740,"alignX":54,"alignY":1740,"disabled":false,"content":{"k":"image","expr":{"k":"id","name":"S"},"mode":"gray","width":130,"height":130,"png":null,"fit":true}},{"id":"46","left":222,"top":1740,"alignX":222,"alignY":1740,"disabled":false,"content":{"k":"image","expr":{"k":"id","name":"B"},"mode":"gray","width":130,"height":130,"png":null,"fit":true}},{"id":"48","left":390,"top":1740,"alignX":390,"alignY":1740,"disabled":false,"content":{"k":"image","expr":{"k":"id","name":"E"},"mode":"gray","width":130,"height":130,"png":null,"fit":true}}],"texts":[{"id":"1","left":54,"top":72,"width":440,"height":27,"text":"Cleaning up a noisy signal. A slow wave measured 128 times with noise on every reading. The noise here is made by formula, sin(1.7·k²), so the sheet gives the same numbers every time."},{"id":"2","left":54,"top":107,"width":440,"height":13.5,"text":"The readings, and the wave under them."},{"id":"7","left":54,"top":192.5,"width":440,"height":40.5,"text":"Three smoothers. medsmooth takes the median of each 7 readings; ksmooth averages them with Gaussian weights, b setting the width; supsmooth, Friedman's super smoother, chooses its own width point by point."},{"id":"12","left":384,"top":309,"width":164,"height":60,"text":"Gray: the readings. Blue: ksmooth. Orange: supsmooth. Dashed: the wave they came from."},{"id":"13","left":54,"top":475,"width":440,"height":13.5,"text":"How far each lands from the wave, as a root-mean-square error, against the noise itself:"},{"id":"19","left":54,"top":560.5,"width":440,"height":27,"text":"Finding a delay. A pulse goes out and its echo comes back late, weaker and noisy. correl lines the echo up against the pulse at every shift; the shift where they agree best is the delay."},{"id":"27","left":54,"top":1030,"width":440,"height":27,"text":"Left: the pulse, blue, and what came back, gray, the echo hard to see. Right: the correlation, which peaks at the delay, 37 samples."},{"id":"28","left":54,"top":1083,"width":440,"height":40.5,"text":"Keeping a tenth. The wavelet transform, wave, spreads the readings over 128 coefficients, most of them small. Keep the 13 largest, set the rest to 0, and iwave rebuilds the signal from them."},{"id":"35","left":384,"top":1237.5,"width":164,"height":60,"text":"Green: the signal from 13 coefficients of 128. It is closer to the wave than the readings were, since much of the noise lived in the small coefficients that were dropped."},{"id":"36","left":54,"top":1411.5,"width":440,"height":27,"text":"A picture blurred. correl2d slides a kernel over a matrix: a 5 × 5 average blurs a white square, and a kernel of −1, 0, 1 finds its left and right edges."},{"id":"45","left":54,"top":1876,"width":130,"height":27,"text":"The square"},{"id":"47","left":222,"top":1876,"width":130,"height":27,"text":"Blurred"},{"id":"49","left":390,"top":1876,"width":130,"height":27,"text":"Its left and right edges"}],"opaque":[],"origin":0,"tol":0.001,"exactCompare":true,"zeroOverZero":false,"otherRegions":{},"componentOutputs":[]}}