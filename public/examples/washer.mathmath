,"name":"F"},{"k":"real","v":160}]}]},{"k":"op","op":"pow","args":[{"k":"id","name":"n"},{"k":"real","v":2}]}]},{"k":"real","v":255}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"32","left":304,"top":981.5,"alignX":304,"alignY":997.5,"disabled":false,"content":{"k":"eval","expr":{"k":"id","name":"A.med"},"stored":null,"unit":null}},{"id":"33","left":434,"top":977.5,"alignX":434,"alignY":997.5,"disabled":false,"content":{"k":"eval","expr":{"k":"op","op":"minus","args":[{"k":"op","op":"div","args":[{"k":"id","name":"A.med"},{"k":"id","name":"A.true"}]},{"k":"real","v":1}]},"stored":null,"unit":null}},{"id":"36","left":54,"top":1125,"alignX":54,"alignY":1141,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"E"},"value":{"k":"call","fn":{"k":"id","name":"sobelEdges"},"args":[{"k":"id","name":"F"}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"37","left":306,"top":1125,"alignX":306,"alignY":1141,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"O"},"value":{"k":"call","fn":{"k":"id","name":"threshold"},"args":[{"k":"id","name":"E"},{"k":"real","v":300}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"38","left":54,"top":1163,"alignX":54,"alignY":1163,"disabled":false,"content":{"k":"image","expr":{"k":"id","name":"E"},"mode":"gray","width":140,"height":140,"png":null,"fit":true}},{"id":"40","left":222,"top":1163,"alignX":222,"alignY":1163,"disabled":false,"content":{"k":"image","expr":{"k":"id","name":"O"},"mode":"gray","width":140,"height":140,"png":null}},{"id":"42","left":390,"top":1163,"alignX":390,"alignY":1163,"disabled":false,"content":{"k":"image","expr":{"k":"call","fn":{"k":"id","name":"ditherFloydSteinberg"},"args":[{"k":"id","name":"F"},{"k":"real","v":2}]},"mode":"gray","width":140,"height":140,"png":null}}],"texts":[{"id":"1","left":54,"top":72,"width":440,"height":54,"text":"Measuring a washer in a noisy picture. An inspection camera photographs a washer on a lit table and must check its area. The picture is noisy, and some of the sensor's pixels are stuck black or white. A matrix is a picture here, so we make one by formula, spoil it, then clean it up and measure."},{"id":"2","left":54,"top":134,"width":440,"height":27,"text":"The scene. A washer with outer radius 45 pixels and hole radius 20, bright on a table lit more on the right."},{"id":"9","left":54,"top":253,"width":440,"height":27,"text":"Each comparison is 1 where it holds and 0 where it doesn't, so the last term adds 130 on the washer only. Its true area, in pixels:"},{"id":"12","left":54,"top":344,"width":440,"height":27,"text":"The camera. Normal noise of 12 gray levels on every pixel, and 3% of pixels stuck at black or white. qnorm of a uniform draw is a normal draw."},{"id":"19","left":54,"top":639,"width":138,"height":27,"text":"As the camera sees it"},{"id":"21","left":222,"top":639,"width":138,"height":27,"text":"Blurred: specks smeared, edges soft"},{"id":"23","left":390,"top":639,"width":138,"height":27,"text":"Median of each 3×3: specks gone, edges sharp"},{"id":"24","left":54,"top":864,"width":440,"height":13.5,"text":"Measure. Threshold at 160 gray, between the table and the washer, and count the white pixels."},{"id":"34","left":54,"top":1023.5,"width":440,"height":40.5,"text":"Stuck pixels throw the raw count off: white ones on the table count as washer, black ones on the washer don't. The median filter removes them and keeps the edges where they were, so its count is the closest."},{"id":"35","left":54,"top":1090,"width":440,"height":27,"text":"Edges. sobelEdges is large where brightness changes fast; a threshold turns it into an outline, as a gauge would use to fit circles."},{"id":"39","left":54,"top":1309,"width":138,"height":27,"text":"Edge strength"},{"id":"41","left":222,"top":1309,"width":138,"height":27,"text":"The outline"},{"id":"43","left":390,"top":1309,"width":138,"height":27,"text":"F dithered to black and white"},{"id":"44","left":54,"top":1343,"width":440,"height":27,"text":"Try it: raise the noise from 12 to 40, or the stuck pixels from 3% to 10%, and see which measurement holds up. Reroll on the toolbar takes a new picture."}],"opaque":[],"origin":0,"tol":0.001,"exactCompare":true,"zeroOverZero":false,"otherRegions":{},"componentOutputs":[]}}