{"format":"mathmath","version":1,"worksheet":{"page":{"width":612,"height":792,"landscape":false,"margins":{"left":36,"right":36,"top":36,"bottom":36}},"format":{"precision":4,"exponent":5,"trailingZeros":false},"assets":{},"regions":[{"id":"3","left":54,"top":142,"alignX":54,"alignY":158,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"H"},"value":{"k":"call","fn":{"k":"id","name":"FIF"},"args":[{"k":"str","v":"9' 6-1/4\""}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"4","left":284,"top":142,"alignX":284,"alignY":158,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"r.max"},"value":{"k":"call","fn":{"k":"id","name":"FIF"},"args":[{"k":"str","v":"7-3/4"}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"5","left":454,"top":142,"alignX":454,"alignY":158,"disabled":false,"content":{"k":"eval","expr":{"k":"id","name":"H"},"stored":null,"unit":null}},{"id":"7","left":54,"top":233,"alignX":54,"alignY":253,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"n"},"value":{"k":"call","fn":{"k":"id","name":"ceil"},"args":[{"k":"op","op":"div","args":[{"k":"id","name":"H"},{"k":"id","name":"r.max"}]}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"8","left":194,"top":237,"alignX":194,"alignY":253,"disabled":false,"content":{"k":"eval","expr":{"k":"id","name":"n"},"stored":null,"unit":null}},{"id":"9","left":284,"top":233,"alignX":284,"alignY":253,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"r"},"value":{"k":"op","op":"div","args":[{"k":"id","name":"H"},{"k":"id","name":"n"}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"10","left":414,"top":237,"alignX":414,"alignY":253,"disabled":false,"content":{"k":"eval","expr":{"k":"id","name":"r"},"stored":null,"unit":{"k":"id","name":"FIF"}}},{"id":"12","left":54,"top":327.5,"alignX":54,"alignY":343.5,"disabled":false,"content":{"k":"eval","expr":{"k":"id","name":"r"},"stored":null,"unit":{"k":"id","name":"in"}}},{"id":"13","left":284,"top":327.5,"alignX":284,"alignY":343.5,"disabled":false,"content":{"k":"eval","expr":{"k":"op","op":"minus","args":[{"k":"op","op":"mult","args":[{"k":"id","name":"n"},{"k":"id","name":"r"}]},{"k":"id","name":"H"}]},"stored":null,"unit":null}},{"id":"15","left":54,"top":418.5,"alignX":54,"alignY":434.5,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"t"},"value":{"k":"call","fn":{"k":"id","name":"FIF"},"args":[{"k":"real","v":0},{"k":"real","v":10},{"k":"real","v":0}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"16","left":254,"top":418.5,"alignX":254,"alignY":434.5,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"L"},"value":{"k":"op","op":"mult","args":[{"k":"op","op":"minus","args":[{"k":"id","name":"n"},{"k":"real","v":1}]},{"k":"id","name":"t"}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"17","left":414,"top":418.5,"alignX":414,"alignY":434.5,"disabled":false,"content":{"k":"eval","expr":{"k":"id","name":"L"},"stored":null,"unit":{"k":"id","name":"FIF"}}},{"id":"18","left":54,"top":456.5,"alignX":54,"alignY":476.5,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"S"},"value":{"k":"op","op":"sqrt","args":[{"k":"op","op":"plus","args":[{"k":"op","op":"pow","args":[{"k":"id","name":"L"},{"k":"real","v":2}]},{"k":"op","op":"pow","args":[{"k":"id","name":"H"},{"k":"real","v":2}]}]}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"19","left":254,"top":460.5,"alignX":254,"alignY":476.5,"disabled":false,"content":{"k":"eval","expr":{"k":"id","name":"S"},"stored":null,"unit":{"k":"id","name":"FIF"}}},{"id":"20","left":414,"top":456.5,"alignX":414,"alignY":476.5,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"θ"},"value":{"k":"call","fn":{"k":"id","name":"atan"},"args":[{"k":"op","op":"div","args":[{"k":"id","name":"H"},{"k":"id","name":"L"}]}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"21","left":54,"top":502.5,"alignX":54,"alignY":532.5,"disabled":false,"content":{"k":"eval","expr":{"k":"id","name":"θ"},"stored":null,"unit":{"k":"id","name":"DMS"}}},{"id":"22","left":284,"top":516.5,"alignX":284,"alignY":532.5,"disabled":false,"content":{"k":"eval","expr":{"k":"id","name":"θ"},"stored":null,"unit":{"k":"id","name":"deg"}}},{"id":"24","left":54,"top":603.5,"alignX":54,"alignY":619.5,"disabled":false,"content":{"k":"eval","expr":{"k":"op","op":"plus","args":[{"k":"id","name":"r"},{"k":"id","name":"t"}]},"stored":null,"unit":{"k":"id","name":"FIF"}}},{"id":"26","left":54,"top":899,"alignX":54,"alignY":915,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"T"},"value":{"k":"op","op":"plus","args":[{"k":"op","op":"mult","args":[{"k":"real","v":3},{"k":"call","fn":{"k":"id","name":"hhmmss"},"args":[{"k":"real","v":0},{"k":"real","v":25},{"k":"real","v":0}]}]},{"k":"op","op":"mult","args":[{"k":"op","op":"minus","args":[{"k":"id","name":"n"},{"k":"real","v":1}]},{"k":"call","fn":{"k":"id","name":"hhmmss"},"args":[{"k":"str","v":"0:06:30"}]}]}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"27","left":454,"top":899,"alignX":454,"alignY":915,"disabled":false,"content":{"k":"eval","expr":{"k":"id","name":"T"},"stored":null,"unit":{"k":"id","name":"hhmmss"}}}],"texts":[{"id":"1","left":54,"top":72,"width":440,"height":40.5,"text":"A staircase in feet and inches. FIF reads a length as a builder writes it, and FIF in a result's unit placeholder shows a length that way, to the nearest fraction of an inch. DMS and hhmmss do the same for angles and times."},{"id":"2","left":54,"top":120.5,"width":440,"height":13.5,"text":"The floor-to-floor rise, taped at 9' 6-1/4\", and the tallest riser the code allows, 7-3/4\"."},{"id":"6","left":54,"top":198,"width":440,"height":27,"text":"The number of risers, and each one's height: the rise shared equally, shown in feet and inches."},{"id":"11","left":54,"top":279,"width":440,"height":40.5,"text":"Fifteen risers of 7-37/60\", a hair under 7-5/8\" on the tape: FIF shows the closest fraction with a denominator up to 256, not the nearest sixteenth. In inches, and checked against the rise:"},{"id":"14","left":54,"top":383.5,"width":440,"height":27,"text":"The run: one tread fewer than the risers, each 10\" deep. Then the stringer, the board the steps are cut from, and its slope."},{"id":"23","left":54,"top":568.5,"width":440,"height":27,"text":"DMS shows the angle as degrees, minutes and seconds: the stringer rises at 39° 13′. The carpenter's rule of thumb for a comfortable step is a riser plus a tread of about 17-1/2\":"},{"id":"25","left":54,"top":864,"width":440,"height":27,"text":"The time to build it: 25 minutes to mark and cut each stringer, three stringers, and 6-1/2 minutes to fit each tread."},{"id":"28","left":54,"top":937,"width":440,"height":27,"text":"2 hours 46 minutes, shown as hours, minutes and seconds. hhmmss reads \"h:mm:ss\" strings, or three numbers."}],"opaque":[],"origin":0,"tol":0.001,"exactCompare":true,"zeroOverZero":false,"otherRegions":{},"componentOutputs":[]}}