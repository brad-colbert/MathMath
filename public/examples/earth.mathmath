v":130},{"k":"real","v":80}]},{"k":"call","fn":{"k":"id","name":"t"},"args":[{"k":"real","v":255},{"k":"real","v":70},{"k":"real","v":200}]}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"36","left":54,"top":1127,"alignX":54,"alignY":1143,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"vivid"},"value":{"k":"call","fn":{"k":"id","name":"hsvToRgb"},"args":[{"k":"call","fn":{"k":"id","name":"joinChannels"},"args":[{"k":"op","op":"indexer","args":[{"k":"id","name":"h"},{"k":"real","v":0}]},{"k":"call","fn":{"k":"id","name":"levels"},"args":[{"k":"op","op":"indexer","args":[{"k":"id","name":"h"},{"k":"real","v":1}]},{"k":"real","v":0},{"k":"real","v":140}]},{"k":"op","op":"indexer","args":[{"k":"id","name":"h"},{"k":"real","v":2}]}]}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"37","left":354,"top":1127,"alignX":354,"alignY":1143,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"swapped"},"value":{"k":"call","fn":{"k":"id","name":"joinChannels"},"args":[{"k":"id","name":"blue"},{"k":"id","name":"green"},{"k":"id","name":"red"}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"38","left":54,"top":1165,"alignX":54,"alignY":1165,"disabled":false,"content":{"k":"image","expr":{"k":"id","name":"map"},"mode":"rgb","width":125,"height":125,"png":null}},{"id":"40","left":222,"top":1165,"alignX":222,"alignY":1165,"disabled":false,"content":{"k":"image","expr":{"k":"id","name":"vivid"},"mode":"rgb","width":125,"height":125,"png":null}},{"id":"42","left":390,"top":1165,"alignX":390,"alignY":1165,"disabled":false,"content":{"k":"image","expr":{"k":"id","name":"swapped"},"mode":"rgb","width":125,"height":125,"png":null}}],"texts":[{"id":"1","left":54,"top":72,"width":440,"height":40.5,"text":"How cloudy is the Earth? On 7 December 1972 the crew of Apollo 17 photographed the whole Earth, lit from behind them: \"The Blue Marble\". NASA's photographs are in the public domain. Here MathMath reads the picture from the web and sorts its pixels into cloud, ocean and land."},{"id":"2","left":54,"top":120.5,"width":440,"height":40.5,"text":"Read it. Files → From a web address on the toolbar fetched this picture and keeps it in the worksheet, so readImage reads it by its address, built here in pieces to fit the page. A color picture is a matrix with its red, green and blue blocks side by side."},{"id":"14","left":54,"top":528,"width":125,"height":27,"text":"The picture"},{"id":"16","left":222,"top":518,"width":115,"height":27,"text":"Red: land and cloud bright, ocean dark"},{"id":"18","left":390,"top":518,"width":115,"height":27,"text":"Blue: the ocean shows up"},{"id":"19","left":54,"top":580,"width":440,"height":27,"text":"Hue, saturation and value. Clouds are bright and nearly gray: high value, low saturation. The ocean is bluer than it is red."},{"id":"23","left":54,"top":653,"width":440,"height":27,"text":"Each test gives 1 where it holds and 0 where it doesn't, and the arrow applies it pixel by pixel, so each of these is a mask:"},{"id":"28","left":54,"top":920,"width":440,"height":13.5,"text":"The answer. Each mask's share of the Earth's disc:"},{"id":"32","left":54,"top":987.5,"width":440,"height":40.5,"text":"About a third of the disc is cloud. Averaged over the year and the whole globe, satellites find about two thirds; this is one afternoon over Africa, and pixels near the edge stand for more of the surface than pixels at the center."},{"id":"33","left":54,"top":1054,"width":440,"height":27,"text":"Pictures from masks. t paints each mask its own level, and joinChannels puts red, green and blue together into a map. Then two changes to the photograph itself."},{"id":"39","left":54,"top":1296,"width":125,"height":27,"text":"Cloud, ocean and land"},{"id":"41","left":222,"top":1296,"width":125,"height":27,"text":"Saturation stretched by levels"},{"id":"43","left":390,"top":1296,"width":125,"height":27,"text":"Red and blue swapped: an orange ocean"},{"id":"44","left":54,"top":1330,"width":440,"height":27,"text":"Try it: change 185 or 60 and watch the cloud share move. Or use Files → From a web address with another picture's address, and put that address in readImage."}],"opaque":[],"origin":0,"tol":0.001,"exactCompare":true,"zeroOverZero":false,"otherRegions":{},"componentOutputs":[]}}