"div","args":[{"k":"id","name":"k"},{"k":"real","v":8000}]}]}]}]}]},{"k":"op","op":"pow","args":[{"k":"id","name":"e"},{"k":"op","op":"neg","args":[{"k":"op","op":"div","args":[{"k":"id","name":"k"},{"k":"real","v":2000}]}]}]}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"27","left":54,"top":958.5,"alignX":54,"alignY":974.5,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"C"},"value":{"k":"op","op":"mult","args":[{"k":"real","v":7500},{"k":"id","name":"c"}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"28","left":214,"top":958.5,"alignX":214,"alignY":974.5,"disabled":false,"content":{"k":"eval","expr":{"k":"call","fn":{"k":"id","name":"max"},"args":[{"k":"id","name":"C"}]},"stored":null,"unit":null}},{"id":"29","left":354,"top":958.5,"alignX":354,"alignY":974.5,"disabled":false,"content":{"k":"define","target":{"k":"fn","name":"WRITEWAV","params":["chime.wav","8000","16"],"file":true},"value":{"k":"id","name":"C"},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"30","left":54,"top":996.5,"alignX":54,"alignY":996.5,"disabled":false,"content":{"k":"plot","x":{"k":"op","op":"div","args":[{"k":"id","name":"k"},{"k":"real","v":8000}]},"ys":[{"k":"op","op":"indexer","args":[{"k":"id","name":"C"},{"k":"id","name":"k"}]}],"markers":false,"width":460,"height":140,"xAxis":{"min":null,"max":null,"log":false,"title":"s"},"yAxis":{"min":null,"max":null,"log":false}}}],"texts":[{"id":"1","left":54,"top":72,"width":440,"height":40.5,"text":"Colour and sound, by the numbers. A picture is three matrices of red, green and blue, 0 to 255, packed side by side; a sound is a column of samples. Both can be worked on as numbers and written out as files."},{"id":"2","left":54,"top":120.5,"width":440,"height":27,"text":"A picture: red rising to the right, green rising downward, blue fixed. joinChannels packs the three 32 × 32 matrices side by side, as readImage gives a picture."},{"id":"9","left":54,"top":249.5,"width":440,"height":40.5,"text":"Hue, lightness and saturation. rgbToHls gives the hue in degrees with 360, as Mathcad's READ_HLS does; imageChannels takes out one of the three. Turning every hue by 120° moves red to green and green to blue, keeping lightness and saturation."},{"id":"17","left":54,"top":510,"width":130,"height":27,"text":"The picture"},{"id":"19","left":222,"top":510,"width":130,"height":27,"text":"Hues turned 120°"},{"id":"21","left":390,"top":510,"width":130,"height":27,"text":"Its lightness"},{"id":"22","left":54,"top":544,"width":440,"height":27,"text":"The lightness is the same in both: only the hue moved. Mathcad's WRITE_HLS writes such a matrix straight to a picture file, and the region offers it to save:"},{"id":"24","left":54,"top":864,"width":440,"height":40.5,"text":"A chime: two notes a major third apart, C and E, dying away over a second, at 8000 samples a second. WRITEWAV writes 16-bit samples, −32768 to 32767, so the chime is scaled to about 11 600 at its loudest."},{"id":"31","left":54,"top":1162.5,"width":440,"height":40.5,"text":"Save chime.wav and play it. WRITEWAV cuts each sample to a whole number, as Mathcad does; one beyond 32767 would wrap round to a loud click rather than stop at the top, so keep the loudest under it."}],"opaque":[],"origin":0,"tol":0.001,"exactCompare":true,"zeroOverZero":false,"otherRegions":{},"componentOutputs":[]}}