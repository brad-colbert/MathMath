"},"args":[{"k":"id","name":"v"}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"25","left":432,"top":508,"alignX":432,"alignY":524,"disabled":false,"content":{"k":"eval","expr":{"k":"id","name":"σ"},"stored":null,"unit":{"k":"id","name":"mV"}}},{"id":"27","left":54,"top":581,"alignX":54,"alignY":597,"disabled":false,"content":{"k":"eval","expr":{"k":"call","fn":{"k":"id","name":"mean"},"args":[{"k":"op","op":"vectorize","args":[{"k":"op","op":"greaterThan","args":[{"k":"op","op":"absval","args":[{"k":"op","op":"minus","args":[{"k":"id","name":"v"},{"k":"id","name":"V.nom"}]}]},{"k":"op","op":"mult","args":[{"k":"real","v":0.02},{"k":"id","name":"V.nom"}]}]}]}]},"stored":null,"unit":null}},{"id":"28","left":314,"top":581,"alignX":314,"alignY":597,"disabled":false,"content":{"k":"eval","expr":{"k":"call","fn":{"k":"id","name":"min"},"args":[{"k":"id","name":"v"}]},"stored":null,"unit":null}},{"id":"29","left":434,"top":581,"alignX":434,"alignY":597,"disabled":false,"content":{"k":"eval","expr":{"k":"call","fn":{"k":"id","name":"max"},"args":[{"k":"id","name":"v"}]},"stored":null,"unit":null}},{"id":"31","left":54,"top":899,"alignX":54,"alignY":919,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"H"},"value":{"k":"call","fn":{"k":"id","name":"histogram"},"args":[{"k":"real","v":40},{"k":"op","op":"div","args":[{"k":"id","name":"v"},{"k":"id","name":"V"}]}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"32","left":222,"top":903,"alignX":222,"alignY":919,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"x"},"value":{"k":"op","op":"matcol","args":[{"k":"id","name":"H"},{"k":"real","v":0}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"33","left":390,"top":903,"alignX":390,"alignY":919,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"Δ"},"value":{"k":"op","op":"minus","args":[{"k":"op","op":"indexer","args":[{"k":"id","name":"x"},{"k":"real","v":1}]},{"k":"op","op":"indexer","args":[{"k":"id","name":"x"},{"k":"real","v":0}]}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"34","left":54,"top":945,"alignX":54,"alignY":965,"disabled":false,"content":{"k":"define","target":{"k":"fn","name":"g","params":["x"]},"value":{"k":"op","op":"mult","args":[{"k":"op","op":"mult","args":[{"k":"id","name":"n"},{"k":"id","name":"Δ"}]},{"k":"call","fn":{"k":"id","name":"dnorm"},"args":[{"k":"id","name":"x"},{"k":"op","op":"div","args":[{"k":"id","name":"μ"},{"k":"id","name":"V"}]},{"k":"op","op":"div","args":[{"k":"id","name":"σ"},{"k":"id","name":"V"}]}]}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"35","left":54,"top":991,"alignX":54,"alignY":991,"disabled":false,"content":{"k":"plot","x":{"k":"id","name":"x"},"ys":[{"k":"op","op":"matcol","args":[{"k":"id","name":"H"},{"k":"real","v":1}]},{"k":"op","op":"vectorize","args":[{"k":"call","fn":{"k":"id","name":"g"},"args":[{"k":"id","name":"x"}]}]}],"markers":false,"width":300,"height":170,"xAxis":{"min":null,"max":null,"log":false},"yAxis":{"min":null,"max":null,"log":false,"title":"boards"},"traces":[{"color":"#2563eb","line":"none","points":"circle"},{"color":"#d97706","line":"solid","weight":2}]}}],"texts":[{"id":"1","left":54,"top":72,"width":440,"height":40.5,"text":"Ten thousand voltage dividers. A sensor needs 1.6 V, made from a 5 V supply by two resistors of 5% tolerance. The worst case says how far off a board could be; a Monte Carlo run says how far off boards actually are."},{"id":"2","left":54,"top":120.5,"width":440,"height":13.5,"text":"The design."},{"id":"10","left":54,"top":244,"width":440,"height":13.5,"text":"Worst case. Every part at the edge of its tolerance, in the direction that hurts."},{"id":"17","left":54,"top":375.5,"width":440,"height":40.5,"text":"Monte Carlo. Real parts scatter: take each resistor as normal, with its tolerance at three standard deviations, and build ten thousand boards. The arrow over Vout applies it board by board."},{"id":"26","left":54,"top":546,"width":440,"height":27,"text":"The worst case is about ±7%, but most boards are much closer. What fraction falls outside ±2% of nominal, and how far out do the extremes of ten thousand get?"},{"id":"30","left":54,"top":864,"width":440,"height":27,"text":"The spread. A histogram of the boards, with the normal curve of the same mean and standard deviation."},{"id":"36","left":394,"top":1021,"width":154,"height":60,"text":"Reroll on the toolbar builds a new ten thousand: the histogram shifts a little, the statistics hardly at all."}],"opaque":[],"origin":0,"tol":0.001,"exactCompare":true,"zeroOverZero":false,"otherRegions":{},"componentOutputs":[]}}