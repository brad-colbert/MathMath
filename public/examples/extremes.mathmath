:54,"alignY":503.5,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"x"},"value":{"k":"range","first":{"k":"real","v":0},"second":{"k":"real","v":0.05},"last":{"k":"real","v":8}},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"20","left":54,"top":525.5,"alignX":54,"alignY":525.5,"disabled":false,"content":{"k":"plot","x":{"k":"id","name":"x"},"ys":[{"k":"call","fn":{"k":"id","name":"drice"},"args":[{"k":"id","name":"x"},{"k":"real","v":0},{"k":"id","name":"σ"}]},{"k":"call","fn":{"k":"id","name":"drice"},"args":[{"k":"id","name":"x"},{"k":"real","v":2},{"k":"id","name":"σ"}]},{"k":"call","fn":{"k":"id","name":"drice"},"args":[{"k":"id","name":"x"},{"k":"real","v":4},{"k":"id","name":"σ"}]}],"markers":false,"width":260,"height":150,"xAxis":{"min":null,"max":null,"log":false},"yAxis":{"min":null,"max":null,"log":false},"traces":[{"color":"#52514e","line":"solid","weight":2},{"color":"#2a78d6","line":"solid","weight":2},{"color":"#eb6834","line":"solid","weight":2}]}},{"id":"23","left":54,"top":912.5,"alignX":54,"alignY":928.5,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"μ.w"},"value":{"k":"real","v":4},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"24","left":134,"top":912.5,"alignX":134,"alignY":928.5,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"κ"},"value":{"k":"real","v":2},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"25","left":214,"top":912.5,"alignX":214,"alignY":928.5,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"θ"},"value":{"k":"range","first":{"k":"op","op":"minus","args":[{"k":"id","name":"μ.w"},{"k":"id","name":"π"}]},"second":{"k":"op","op":"plus","args":[{"k":"op","op":"minus","args":[{"k":"id","name":"μ.w"},{"k":"id","name":"π"}]},{"k":"real","v":0.02}]},"last":{"k":"op","op":"plus","args":[{"k":"id","name":"μ.w"},{"k":"id","name":"π"}]}},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"26","left":54,"top":950.5,"alignX":54,"alignY":950.5,"disabled":false,"content":{"k":"plot","x":{"k":"id","name":"θ"},"ys":[{"k":"call","fn":{"k":"id","name":"dvonmises"},"args":[{"k":"id","name":"θ"},{"k":"id","name":"μ.w"},{"k":"id","name":"κ"}]}],"markers":false,"width":200,"height":200,"xAxis":{"min":null,"max":null,"log":false},"yAxis":{"min":null,"max":null,"log":false},"view":"polar","traces":[{"color":"#2a78d6","weight":2}]}},{"id":"28","left":54,"top":1176.5,"alignX":54,"alignY":1196.5,"disabled":false,"content":{"k":"eval","expr":{"k":"op","op":"minus","args":[{"k":"call","fn":{"k":"id","name":"pvonmises"},"args":[{"k":"op","op":"plus","args":[{"k":"id","name":"μ.w"},{"k":"op","op":"div","args":[{"k":"id","name":"π"},{"k":"real","v":6}]}]},{"k":"id","name":"μ.w"},{"k":"id","name":"κ"}]},{"k":"call","fn":{"k":"id","name":"pvonmises"},"args":[{"k":"op","op":"minus","args":[{"k":"id","name":"μ.w"},{"k":"op","op":"div","args":[{"k":"id","name":"π"},{"k":"real","v":6}]}]},{"k":"id","name":"μ.w"},{"k":"id","name":"κ"}]}]},"stored":null,"unit":null}},{"id":"30","left":54,"top":1289,"alignX":54,"alignY":1309,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"a"},"value":{"k":"op","op":"sqrt","args":[{"k":"op","op":"div","args":[{"k":"op","op":"mult","args":[{"k":"op","op":"mult","args":[{"k":"real","v":1.380649},{"k":"op","op":"pow","args":[{"k":"real","v":10},{"k":"real","v":-23}]}]},{"k":"real","v":300}]},{"k":"op","op":"mult","args":[{"k":"real","v":4.652},{"k":"op","op":"pow","args":[{"k":"real","v":10},{"k":"real","v":-26}]}]}]}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"31","left":254,"top":1289,"alignX":254,"alignY":1309,"disabled":false,"content":{"k":"eval","expr":{"k":"op","op":"mult","args":[{"k":"id","name":"a"},{"k":"op","op":"sqrt","args":[{"k":"real","v":2}]}]},"stored":null,"unit":null}},{"id":"32","left":374,"top":1293,"alignX":374,"alignY":1309,"disabled":false,"content":{"k":"eval","expr":{"k":"op","op":"minus","args":[{"k":"real","v":1},{"k":"call","fn":{"k":"id","name":"pmaxwell"},"args":[{"k":"real","v":1000},{"k":"id","name":"a"}]}]},"stored":null,"unit":null}},{"id":"34","left":54,"top":1405.5,"alignX":54,"alignY":1421.5,"disabled":false,"content":{"k":"eval","expr":{"k":"call","fn":{"k":"id","name":"ptri"},"args":[{"k":"real","v":7},{"k":"real","v":3},{"k":"real","v":10},{"k":"real","v":5}]},"stored":null,"unit":null}},{"id":"35","left":224,"top":1405.5,"alignX":224,"alignY":1421.5,"disabled":false,"content":{"k":"eval","expr":{"k":"call","fn":{"k":"id","name":"qtri"},"args":[{"k":"real","v":0.9},{"k":"real","v":3},{"k":"real","v":10},{"k":"real","v":5}]},"stored":null,"unit":null}},{"id":"36","left":394,"top":1401.5,"alignX":394,"alignY":1421.5,"disabled":false,"content":{"k":"eval","expr":{"k":"op","op":"div","args":[{"k":"op","op":"plus","args":[{"k":"op","op":"plus","args":[{"k":"real","v":3},{"k":"real","v":10}]},{"k":"real","v":5}]},{"k":"real","v":3}]},"stored":null,"unit":null}}],"texts":[{"id":"1","left":54,"top":72,"width":440,"height":22,"text":"Floods, signals and winds","style":{"bold":true,"size":16}},{"id":"2","left":54,"top":102,"width":440,"height":40.5,"text":"Each distribution has four functions: d for its density, p for the chance of a value at or below x, q to go back from a chance to a value, and r for random draws. These five answer questions the normal distribution can't."},{"id":"3","left":54,"top":150.5,"width":440,"height":54,"text":"The hundred-year flood. A river's highest level each year follows the Gumbel distribution, the law of maxima. Here 60 years of yearly peaks, in metres, are drawn from it; then its location μ and scale β are estimated from their mean and standard deviation, by the method of moments."},{"id":"10","left":54,"top":296.5,"width":440,"height":40.5,"text":"The level reached one year in a hundred is qgumbel at 0.99, well over two metres above the commonest peak, μ. The chance that a given year tops 7 m, and that one of the next 30 years does:"},{"id":"14","left":54,"top":401,"width":440,"height":40.5,"text":"A radar threshold. With noise alone, the amplitude a receiver sees follows the Rayleigh distribution; with a target's echo of amplitude ν in it, the Rice distribution. Set the threshold so noise crosses it once in a thousand looks, then ask how often an echo does."},{"id":"21","left":344,"top":555.5,"width":204,"height":60,"text":"Noise alone, gray, is Rayleigh: Rice with ν = 0. An echo of 2, blue, and of 4, orange, move the curve out past the threshold of about 3.7: the stronger echo is seen about two times in three."},{"id":"22","left":54,"top":864,"width":440,"height":40.5,"text":"Wind. Directions are angles, which wrap round: the von Mises distribution is the normal distribution of a circle. Here the wind blows mostly towards μ, 4 radians from east, κ saying how steadily. The polar plot is its density round the compass."},{"id":"27","left":284,"top":980.5,"width":264,"height":60,"text":"The chance the wind is within 30° of its usual direction: the cumulative at either side, subtracted. With κ = 0 every direction would be equally likely, and the answer one in six."},{"id":"29","left":54,"top":1240.5,"width":440,"height":40.5,"text":"Molecules. In a gas, speeds follow the Maxwell–Boltzmann distribution with scale a = √(kT/m). For nitrogen at 300 K, in m/s: the likeliest speed is a·√2, and the share of molecules faster than 1 km/s is small."},{"id":"33","left":54,"top":1353,"width":440,"height":40.5,"text":"An estimate. A task will take at least 3 days, most likely 5, and at most 10. The triangular distribution makes that a curve: the chance it is done within a week, and the time to promise to be 90% sure."},{"id":"37","left":54,"top":1447.5,"width":440,"height":27,"text":"The mean, 6 days, is past the likeliest 5: the long side of the triangle pulls it. Laplace and Pareto, for sharp peaks and long tails, round out the eight families MathMath adds."}],"opaque":[],"origin":0,"tol":0.001,"exactCompare":true,"zeroOverZero":false,"otherRegions":{},"componentOutputs":[]}}