k":"id","name":"R.vac"}]},"stored":null,"unit":null}},{"id":"27","left":54,"top":885.5,"alignX":54,"alignY":901.5,"disabled":false,"content":{"k":"define","target":{"k":"var","name":"x"},"value":{"k":"range","first":{"k":"op","op":"mult","args":[{"k":"real","v":0},{"k":"id","name":"m"}]},"second":{"k":"op","op":"mult","args":[{"k":"real","v":0.5},{"k":"id","name":"m"}]},"last":{"k":"id","name":"R.vac"}},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"28","left":204,"top":885.5,"alignX":204,"alignY":901.5,"disabled":false,"content":{"k":"define","target":{"k":"fn","name":"y","params":["x"]},"value":{"k":"call","fn":{"k":"id","name":"linterp"},"args":[{"k":"op","op":"matcol","args":[{"k":"id","name":"S"},{"k":"real","v":1}]},{"k":"op","op":"matcol","args":[{"k":"id","name":"S"},{"k":"real","v":2}]},{"k":"id","name":"x"}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"29","left":54,"top":923.5,"alignX":54,"alignY":943.5,"disabled":false,"content":{"k":"define","target":{"k":"fn","name":"y.vac","params":["x"]},"value":{"k":"op","op":"minus","args":[{"k":"op","op":"mult","args":[{"k":"id","name":"x"},{"k":"call","fn":{"k":"id","name":"tan"},"args":[{"k":"id","name":"θ"}]}]},{"k":"op","op":"div","args":[{"k":"op","op":"mult","args":[{"k":"id","name":"g"},{"k":"op","op":"pow","args":[{"k":"id","name":"x"},{"k":"real","v":2}]}]},{"k":"op","op":"mult","args":[{"k":"op","op":"mult","args":[{"k":"real","v":2},{"k":"op","op":"pow","args":[{"k":"id","name":"v.0"},{"k":"real","v":2}]}]},{"k":"op","op":"pow","args":[{"k":"call","fn":{"k":"id","name":"cos"},"args":[{"k":"id","name":"θ"}]},{"k":"real","v":2}]}]}]}]},"global":false,"stored":null,"unit":null,"shown":false}},{"id":"30","left":54,"top":969.5,"alignX":54,"alignY":969.5,"disabled":false,"content":{"k":"plot","x":{"k":"id","name":"x"},"ys":[{"k":"call","fn":{"k":"id","name":"y"},"args":[{"k":"id","name":"x"}]},{"k":"call","fn":{"k":"id","name":"y.vac"},"args":[{"k":"id","name":"x"}]}],"markers":false,"width":440,"height":170,"xAxis":{"min":null,"max":null,"log":false,"unit":{"k":"id","name":"m"}},"yAxis":{"min":{"k":"real","v":0},"max":null,"log":false,"unit":{"k":"id","name":"m"}},"traces":[{"color":"#2563eb","weight":2},{"color":"#9ca3af","line":"dash"}]}}],"texts":[{"id":"1","left":54,"top":72,"width":440,"height":40.5,"text":"A baseball and the air. A fielder throws a baseball at 40 m/s, 35° above level ground. How far does it go? The textbook answer leaves out the air; here we solve the motion with drag too, and compare."},{"id":"2","left":54,"top":120.5,"width":440,"height":13.5,"text":"The ball and the air. Drag grows with the square of the speed: F = ½·ρ·Cd·A·v²."},{"id":"13","left":54,"top":298,"width":440,"height":13.5,"text":"In a vacuum, the range has a formula. g, the acceleration of gravity, is built in."},{"id":"16","left":54,"top":383.5,"width":440,"height":27,"text":"With drag. The state u is position and velocity, (x, y, vx, vy), each in its own unit. D gives its rate of change, and rkfixed steps it forward in time."},{"id":"20","left":54,"top":536.5,"width":440,"height":27,"text":"S has a row for each step: time, x, y, vx and vy. The ball lands where y comes back to zero: root finds that time, and linterp reads x there."},{"id":"26","left":54,"top":864,"width":440,"height":13.5,"text":"The flight. Drag shortens the throw, and the ball comes down more steeply than it went up."},{"id":"31","left":54,"top":1165.5,"width":440,"height":13.5,"text":"Try it: change v₀ or θ above, or set Cd to 0 and watch the two curves meet."}],"opaque":[],"origin":0,"tol":0.001,"exactCompare":true,"zeroOverZero":false,"otherRegions":{},"componentOutputs":[]}}