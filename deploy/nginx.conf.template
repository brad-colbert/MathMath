# Serves the built app over HTTPS. Generated by deploy/render-nginx.ts, which puts in the content security
# policy from vite.config.ts, so the policy the tests check is the policy served.
#
# Every response carries the policy, not just the page: a worker is held to the policy sent with its own
# script. nginx drops inherited add_header lines in any location that adds its own, so each location repeats
# them through the include.

server {
    # Inside the container only, for the health check. The published port is HTTPS.
    listen 80;
    location = /healthz { access_log off; default_type text/plain; return 200 "ok\n"; }
    location / { return 404; }
}

server {
    listen 443 ssl;
    http2 on;
    ssl_certificate     /etc/nginx/certs/server.crt;
    ssl_certificate_key /etc/nginx/certs/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    root /usr/share/nginx/html;
    index index.html;
    include /etc/nginx/mathmath-headers.conf;

    gzip on;
    gzip_types text/css application/javascript application/json application/manifest+json application/wasm image/svg+xml text/plain;
    gzip_min_length 1024;

    # Built files have content hashes in their names, so they never change.
    location /assets/ {
        include /etc/nginx/mathmath-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }
    # nginx's list of file types has no entry for an app manifest. A types block here would replace the whole
    # list, so the one file gets its type by name.
    location = /manifest.webmanifest {
        include /etc/nginx/mathmath-headers.conf;
        default_type application/manifest+json;
    }
    # The page itself is checked every time, so a new deploy shows at once.
    location = /index.html {
        include /etc/nginx/mathmath-headers.conf;
        add_header Cache-Control "no-cache" always;
    }
    location / {
        try_files $uri $uri/ =404;
    }
}
