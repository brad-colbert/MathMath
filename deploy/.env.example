# Copy to deploy/.env (which git ignores) and fill in. deploy/deploy.sh reads it.
# The ssh host to deploy to, and the folder there. It must not be inside a synced folder such as Dropbox.
REMOTE=myserver
REMOTE_DIR=/home/me/MathMath
# The HTTPS port to publish.
HTTPS_PORT=8888
# Names and addresses the certificate covers, separated by commas: every name browsers will use.
HOSTNAMES=myserver.lan,myserver,10.0.0.10
